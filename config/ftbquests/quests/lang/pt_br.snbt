	quest.3121FB70E83E2B05.quest_desc: ["O minério de Dracônio fica no Overworld, no Nether e principalmente no End."]
	quest.3121FB70E83E2B05.title: "Dracônio"
	quest.31252293733110C9.quest_desc: ["Todos os terminais sem fio num só. Com o Quantum Bridge Card, funciona em qualquer lugar."]
	quest.31252293733110C9.title: "Terminal Universal"
	quest.313F53AC1E5F2A4B.quest_desc: ["Monte qualquer arma na Bancada de Armas e faça a munição dela. Recarregue com R."]
	quest.313F53AC1E5F2A4B.title: "A Sua Primeira Arma"
	quest.324C6D16D6376050.quest_desc: ["Minera 3 x 3 usando água e combustível."]
	quest.324C6D16D6376050.title: "Broca a Vapor"
	quest.32789B78ED2B6685.quest_desc: ["Energia sem fio: um Flux Plug recebe energia e os Flux Points entregam, em qualquer lugar da mesma rede."]
	quest.32789B78ED2B6685.title: "Flux Networks"
	quest.328CAF84E6C78AA2.quest_desc: ["Achado em meteoritos e crescido de blocos Budding Certus. Carregue num Charger para o Charged Certus."]
	quest.328CAF84E6C78AA2.title: "Quartzo Certus"
	quest.32D2E9D5C74FD448.quest_desc: ["Feito com derivados do petróleo no TFMG. Usado em canos e eletrônicos."]
	quest.32D2E9D5C74FD448.title: "Plástico"
	quest.32D8AFB45BE70AE4.quest_desc: ["Coloque o item no Apparatus e os ingredientes nos pedestais em volta. Usa Source."]
	quest.32D8AFB45BE70AE4.title: "Enchanting Apparatus"
	quest.32F1C5A970266EEC.quest_desc: ["Salve lugares e abra uma porta do tempo para qualquer um deles. Ele recarrega com o tempo ou com combustível, como mostra o item."]
	quest.32F1C5A970266EEC.title: "Tempad"
	quest.32FF66B31E1EADF0.quest_desc: ["Diamante no Energizing Orb. Cada nível de cristal libera máquinas melhores."]
	quest.32FF66B31E1EADF0.title: "Cristal Niótico"
	quest.3300CA3DB86198FD.quest_desc: ["Energia simples do RFTools."]
	quest.3300CA3DB86198FD.title: "Gerador a Carvão"
	quest.3342236426FE5541.quest_desc: ["Reproduz duas abelhas engaioladas com energia, sem flores nem espaço."]
	quest.3342236426FE5541.title: "Câmara de Reprodução"
	quest.334B8B6BF5865CCD.quest_desc: ["Um metal do Outro Mundo."]
	quest.334B8B6BF5865CCD.title: "Iesnium"
	quest.336D2C86E1994C2B.quest_desc: ["Ligue a qualquer bloco com o binder: ele vira uma cópia remota do inventário, tanque e energia daquele bloco."]
	quest.336D2C86E1994C2B.title: "Bloco Entrelaçado"
	quest.33B8B317B3297CFC.quest_desc: ["Mantém itens em estoque pedindo fabricação sozinho."]
	quest.33B8B317B3297CFC.title: "ME Requester"
	quest.3430BF3C51AC0A20.quest_desc: ["Abre para quem tiver um cartão do nível certo."]
	quest.3430BF3C51AC0A20.title: "Leitor de Cartão"
	quest.344D1B81117D8183.quest_desc: ["Pérola do Ender + Pó de Blaze. Jogue um: ele voa na direção da Fortaleza, onde fica o Portal do End."]
	quest.344D1B81117D8183.title: "Olhos do Ender"
	quest.346219F82DD78CB1.quest_desc: ["Fabrica sementes: o altar no meio e 8 pedestais em volta. Ative com uma Wand ou redstone."]
	quest.346219F82DD78CB1.title: "Altar de Infusão"
	quest.3518E4EB74D0010C.quest_desc: ["Dobra os minérios em pós."]
	quest.3518E4EB74D0010C.title: "Triturador"
	quest.35321664DEC44057.quest_desc: ["Colheitadeiras numa máquina móvel colhem e replantam as plantações."]
	quest.35321664DEC44057.title: "Máquinas de Fazenda"
	quest.35AB8A541BCE3D1A.quest_desc: ["Agache + use para salvar um lugar. Use um Stable Warp Scroll num ritual para abrir um portal permanente."]
	quest.35AB8A541BCE3D1A.title: "Pergaminhos de Teleporte"
	quest.35C11BCD2EB15B45.quest_desc: ["Fabrica peças do Oritech sozinho."]
	quest.35C11BCD2EB15B45.title: "Assembler"
	quest.3604D56701EBBA80.quest_desc: [
		"O Sujjs's Ores adiciona os metais que todo mod de tecnologia usa: estanho, chumbo, prata, níquel, alumínio, zinco, ósmio, platina, urânio e irídio, além de gemas e ligas."
		"Cada metal tem minérios no Overworld, no Nether e no End."
	]
	quest.3604D56701EBBA80.title: "Sujjs's Ores"
	quest.360550F90247C88E.quest_desc: ["Segure o botão direito com um escudo para bloquear flechas e ataques."]
	quest.360550F90247C88E.title: "Escudo"
	quest.360AF04DDB8036A7.quest_desc: ["Guarda energia; células encostadas viram uma bateria grande."]
	quest.360AF04DDB8036A7.title: "Célula de Energia"
	quest.36254BC46C8B9C48.quest_desc: ["Funde deutério e trítio. Dê a partida com um laser e um Hohlraum."]
	quest.36254BC46C8B9C48.title: "Reator de Fusão"
	quest.3640C30AFF0776EB.quest_desc: ["Os mobs derrubam corações. Transforme em recipientes e coloque no Heart Amulet para ganhar mais vida."]
	quest.3640C30AFF0776EB.title: "Recipientes de Coração"
	quest.364529014F26A865.quest_desc: ["Carrega os itens do seu inventário sem fio. Ligue com um Binding Card."]
	quest.364529014F26A865.title: "Player Transmitter"
	quest.36C9880D09630020.quest_desc: ["O primeiro chefão, no Naga Courtyard. Cada chefão libera as próximas áreas."]
	quest.36C9880D09630020.title: "A Naga"
	quest.36EE54747CCD1DA4.quest_desc: ["Mói minérios em pós com bônus. Bolas de moagem aumentam o bônus."]
	quest.36EE54747CCD1DA4.title: "SAG Mill"
	quest.3703E6E7687B0650.quest_desc: ["Pouse na Lua."]
	quest.3703E6E7687B0650.title: "Um Pequeno Passo"
	quest.376C0126858C7C64.quest_desc: ["Invoque um Foliot. Os espíritos trabalham para você: mineram, carregam itens e fabricam."]
	quest.376C0126858C7C64.title: "O Seu Primeiro Espírito"
	quest.3796E3EC08E3CC4F.quest_desc: ["Mandam energia sem fio entre os relays: ligue com a Laser Wrench."]
	quest.3796E3EC08E3CC4F.title: "Laser Relays"
	quest.37B4BF1DC3968C88.quest_desc: ["O chefão de fogo da Burning Arena. No Sujjs Legacy ele tem 1.000 de vida."]
	quest.37B4BF1DC3968C88.title: "Ignis"
	quest.37C779F47B47D72F.quest_desc: ["Mate mobs e colete almas com o Soul Extractor para usar na forja."]
	quest.37C779F47B47D72F.title: "Almas"
	quest.3836C1245FA6855B.quest_desc: ["Faça o Ritual of Wilden Summoning com um Wilden Horn, Spike e Wing. Derrote a Chimera para ganhar o Wilden Tribute, necessário para o Livro de Arquimago."]
	quest.3836C1245FA6855B.title: "Wilden Chimera"
	quest.38848188DD467B49.quest_desc: ["No Aurora Palace, na Floresta Nevada."]
	quest.38848188DD467B49.title: "A Rainha da Neve"
	quest.38CE52F3E2D80856.quest_desc: [
		"{image:kubejs:textures/quests/usina_nuclear.png width:256 height:144 align:center}"
		""
		"Usinas nucleares abandonadas estão espalhadas pela Dimensão Radioativa."
		""
		"Encontre uma. Elas guardam loot e o caminho até o Nucleon."
	]
	quest.38CE52F3E2D80856.title: "Usinas Nucleares"
	quest.38CE75FBBCD358B4.quest_desc: ["Deixa você ver os Vengeance Spirits que aparecem quando os mobs morrem. Capture numa Box of Eternal Closure."]
	quest.38CE75FBBCD358B4.title: "Vengeance Ring"
	quest.38D8F3AAFA70EE34.quest_desc: [
		"{image:kubejs:textures/quests/reator_noite.png width:256 height:144 align:center}"
		""
		"Encha o reator com tudo: a Bomba Atômica no centro da estrela, o Controlador Dimensional, 4 Munições Infinitas, 256 Munições Universais, 256 Balas Radioativas, 12 Frascos Radioativos, 4 Cristais de Fogo, os itens mais fortes de cada mod, cinco fluidos, Source e 3,5 milhões de FE por tick."
		""
		"Dez minutos depois, nasce o The Absolute."
	]
	quest.38D8F3AAFA70EE34.quest_subtitle: "O fim do Sujjs Legacy"
	quest.38D8F3AAFA70EE34.title: "&d&lO ABSOLUTO"
	quest.38F8CC7EA8FE3F6B.quest_desc: ["Guarda vários packs de flechas e deixa escolher qual atirar."]
	quest.38F8CC7EA8FE3F6B.title: "Aljava"
	quest.38FC0827889ECC53.quest_desc: ["As máquinas de bronze funcionam com vapor de uma caldeira. Ligue com canos de fluido."]
	quest.38FC0827889ECC53.title: "Máquinas a Vapor"
	quest.38FE715E0B2A7C56.quest_desc: ["Mova itens, fluidos e energia pela rede lógica."]
	quest.38FE715E0B2A7C56.title: "Integrated Tunnels"
	quest.390DB1B18E0D06AC.quest_desc: ["Um computador na sua mão."]
	quest.390DB1B18E0D06AC.title: "Computador de Bolso"
	quest.3968AA10966DFF7E.quest_desc: ["O lixo nuclear vai para a Isotopic Centrifuge e a Pressurized Reaction Chamber para virar plutônio."]
	quest.3968AA10966DFF7E.title: "Plutônio"
	quest.3978672AA2803039.quest_desc: ["Feitas na UV Light Box e no Etching Tank. Necessárias para drones."]
	quest.3978672AA2803039.title: "Placas de Circuito"
	quest.39A404E822CE6229.quest_desc: ["Uma mão robô: usa o item que segura, como um jogador clicando com o botão direito."]
	quest.39A404E822CE6229.title: "Deployer"
	quest.39E7E75137C043A0.quest_desc: ["A armadura quântica deixa você quase imortal. No Sujjs Legacy, as peças começam como Quantum Quebradas, consertadas com Nucleon."]
	quest.39E7E75137C043A0.title: "Equipamento Quântico"
	quest.39F72B871412B0ED.quest_desc: ["Um chefão fóssil na Cursed Pyramid do deserto. Leve o Necklace of the Desert."]
	quest.39F72B871412B0ED.title: "Ancient Remnant"
	quest.3A0E47DEE6E96E21.quest_desc: ["Broca, motosserra e jetpack com energia. Carregue no Charger."]
	quest.3A0E47DEE6E96E21.title: "Ferramentas"
	quest.3A14C0D684B4CFB7.quest_desc: ["As Energy Cells guardam energia para os picos de fabricação."]
	quest.3A14C0D684B4CFB7.title: "Energia da Rede"
	quest.3A205942F00A954F.quest_desc: ["O Powah fabrica com energia: coloque Energizing Rods em volta do Energizing Orb, dê energia a elas e jogue os itens no Orb."]
	quest.3A205942F00A954F.title: "Energizing Orb"
	quest.3A3BD54969210131.quest_desc: ["Capture abelhas e carregue. Solte perto de uma colmeia."]
	quest.3A3BD54969210131.title: "Gaiola de Abelha"
	quest.3B4F92A13DD5D7FB.quest_desc: ["Os motores de foguete do Propulsed dão aos seus veículos o maior empuxo de todos."]
	quest.3B4F92A13DD5D7FB.title: "Motores de Foguete"
	quest.3B72BB4EEEF3B76F.quest_desc: ["Cada nível de cabo (LV, MV, HV, EV) só liga em máquinas do seu nível. Use transformadores entre os níveis."]
	quest.3B72BB4EEEF3B76F.title: "Cabos e Baterias"
	quest.3B885710E4B0C79B.quest_desc: ["Uma estrutura que gera minérios do nada usando brocas como ferramenta."]
	quest.3B885710E4B0C79B.title: "Pedreira a Vapor"
	quest.3BA0150F7C255FAB.quest_desc: ["Dê a uma Blaze Burner para superaquecer, necessário para as receitas mais quentes, como o Bloco Absoluto."]
	quest.3BA0150F7C255FAB.title: "Blaze Cake"
	quest.3BAA21F879F43D20.quest_desc: [
		"O Ars Nouveau deixa você criar os seus próprios feitiços. Abra o livro (tecla C por padrão) e combine uma Forma, Efeitos e Aumentos."
		"O Worn Notebook explica tudo dentro do jogo."
	]
	quest.3BAA21F879F43D20.title: "Livro de Feitiços"
	quest.3BC3B348C1D4EA1A.quest_desc: ["Discos muito maiores para redes enormes."]
	quest.3BC3B348C1D4EA1A.title: "Discos Extras"
	quest.3BD2540C80E5957C.quest_desc: ["Uma adaga que quebra a magia: remove efeitos e contratos."]
	quest.3BD2540C80E5957C.title: "Rule Breaker"
	quest.3C3645821AD9A1BE.quest_desc: ["Cai do Ignis. Faz o Incinerator e a armadura de Ignitium."]
	quest.3C3645821AD9A1BE.title: "Ignitium"
	quest.3C3C72B1D5EF54AD.quest_desc: [
		"Feito na Fusion Crafting do Draconic Evolution, no nível Caótico, a partir de um Portable Teleporter do Mekanism e 14 injetores."
		""
		"Use para viajar entre o Overworld e a Dimensão Radioativa."
	]
	quest.3C3C72B1D5EF54AD.quest_subtitle: "A chave da Dimensão Radioativa"
	quest.3C3C72B1D5EF54AD.title: "Controlador Dimensional"
	quest.3CB6C3C6E2B6922A.quest_desc: ["Queima mel para gerar energia."]
	quest.3CB6C3C6E2B6922A.title: "Gerador a Mel"
	quest.3CF900C7C625728C.quest_desc: ["Guarda energia; bancos encostados viram um só."]
	quest.3CF900C7C625728C.title: "Banco de Capacitores"
	quest.3D5355DEDF9D1F24.quest_desc: ["Eixos levam a rotação em linha. Engrenagens passam a rotação para o lado. Uma engrenagem grande ao lado de uma pequena muda a velocidade."]
	quest.3D5355DEDF9D1F24.title: "Eixos e Engrenagens"
	quest.3DDB9BDDFECD6943.quest_desc: [
		"O The Absolute junta os itens mais fortes do modpack inteiro:"
		""
		"- 4 Chaotic Cores (Draconic Evolution)"
		"- 4 Antimatter Pellets (Mekanism)"
		"- 4 Nitro Crystals (Powah)"
		"- 2 Insanium Blocks (Mystical Agradditions)"
		"- 2 Quantum Processors (Advanced AE)"
		"- 2 Quantum Circuits (Modern Industrialization)"
		"- 1 Manhattan Module (Oritech)"
	]
	quest.3DDB9BDDFECD6943.title: "O Melhor de Cada Mod"
	quest.3E1A4D364518CD42.quest_desc: ["Coloque um aldeão e uma estação de trabalho dentro para negociar sem o aldeão fugir."]
	quest.3E1A4D364518CD42.title: "Bloco de Comércio"
	quest.3EEA25DD8F45ED0C.quest_desc: ["Acesse a rede de qualquer lugar no alcance com um Wireless Terminal."]
	quest.3EEA25DD8F45ED0C.title: "Sem Fio"
	quest.3F5FCC608CAD066C.quest_desc: ["Deixa as máquinas rodarem receitas de até 1.024 EU/t, como a Munição Universal."]
	quest.3F5FCC608CAD066C.title: "Casco Turbo"
	quest.3FA24665898BE366.quest_desc: ["Fabrica circuitos e peças bem mais barato do que à mão. Mais tarde, faz a Munição Universal."]
	quest.3FA24665898BE366.title: "Assembler"
	quest.3FAF342519755DF7.quest_desc: ["O seu primeiro foguete. Ele chega até a Lua."]
	quest.3FAF342519755DF7.title: "Foguete Nível 1"
	quest.3FB1B90D5A39169A.quest_desc: ["O Dragão do Ender solta o coração. Reviva o dragão com 4 Cristais do End para conseguir mais."]
	quest.3FB1B90D5A39169A.title: "Dragon Heart"
	quest.3FD6A0EA7FC1BD17.quest_desc: ["Extraia o núcleo de um spawner e coloque num Pressurized Spawner para criar mobs com ar."]
	quest.3FD6A0EA7FC1BD17.title: "Spawner Pressurizado"
	quest.3FE415A6E28BAAB3.quest_desc: ["Uma estrutura oca que comprime itens sob pressão, como ferro em Compressed Iron."]
	quest.3FE415A6E28BAAB3.title: "Pressure Chamber"
	quest.4004B6CB1A3BC28B.quest_desc: ["Clique com o botão direito para ligar: ele puxa os itens próximos até você."]
	quest.4004B6CB1A3BC28B.title: "Ímã"
	quest.4006973ECF75B995.quest_desc: ["O último foguete. Ele chega a outro sistema estelar."]
	quest.4006973ECF75B995.title: "Foguete Nível 4"
	quest.401D99DE70E1BD8B.quest_desc: ["Um reator com refrigeração ativa faz vapor; a turbina transforma em muita energia."]
	quest.401D99DE70E1BD8B.title: "Turbina"
	quest.404317C0236FBECE.quest_desc: ["Um metal condutor usado em fios e eletrônicos."]
	quest.404317C0236FBECE.title: "Prata"
	quest.4048B0483764C65A.quest_desc: ["Signalum (redstone), Lumium (glowstone) e Enderium (pérolas do ender). O Enderium entra na cadeia da Munição Universal."]
	quest.4048B0483764C65A.title: "Ligas Avançadas"
	quest.40F87EB6BFED9ABE.quest_desc: ["Coloque um item na tábua e clique com a faca para cortar."]
	quest.40F87EB6BFED9ABE.title: "Tábua de Corte"
	quest.412AD5EFA1997FFD.quest_desc: ["Guarde gases e químicos do Mekanism na rede ME."]
	quest.412AD5EFA1997FFD.title: "Applied Mekanistics"
	quest.412D11109C405D0B.quest_desc: ["Uma mistura de máquinas úteis. O Empowerer e os Display Stands melhoram os Cristais em cristais potencializados."]
	quest.412D11109C405D0B.title: "Actually Additions"
	quest.4148E8BF1219DD33.quest_desc: ["Tire encantamentos dos itens para livros e aplique livros com Essence."]
	quest.4148E8BF1219DD33.title: "Encantamentos"
	quest.417E2E068326EF7A.quest_desc: ["Um elevador de verdade com andares: coloque blocos Contact em cada andar."]
	quest.417E2E068326EF7A.title: "Elevador"
	quest.419A449D685F68CF.quest_desc: ["Diferente do AE2, os discos guardam qualquer quantidade de tipos; só o total importa."]
	quest.419A449D685F68CF.title: "Discos de Armazenamento"
	quest.41A191D9C25F7DCD.quest_desc: ["Infunda ferro com carbono duas vezes para ter aço e faça Steel Casings: o corpo de toda máquina."]
	quest.41A191D9C25F7DCD.title: "Steel Casing"
	quest.41A92C255D14C42E.quest_desc: ["Um metal leve para cabos, foguetes e o Modern Industrialization."]
	quest.41A92C255D14C42E.title: "Alumínio"
	quest.41E3847FDE8A1084.quest_desc: ["Os lasers quebram blocos e carregam o Laser Amplifier, que dá a partida no Reator de Fusão."]
	quest.41E3847FDE8A1084.title: "Lasers"
	quest.421F935D92ACB8D5.quest_desc: ["Vênus e Mercúrio são quentes o bastante para queimar um traje comum. O Traje Espacial de Netherite aguenta o calor."]
	quest.421F935D92ACB8D5.title: "Traje Espacial de Netherite"
	quest.42612F6D3081EEFE.quest_desc: ["Programe drones no Programmer com peças de quebra-cabeça: cavar, construir, buscar itens, lutar."]
	quest.42612F6D3081EEFE.title: "Drones"
	quest.42631E5641566C9E.quest_desc: ["Vara de Blaze no Energizing Orb."]
	quest.42631E5641566C9E.title: "Cristal Flamejante"
	quest.42664A5D7602C8F3.quest_desc: ["Os monstros derrubam Essência de Inferium. Também existe minério de Inferium. É o começo da agricultura mágica."]
	quest.42664A5D7602C8F3.title: "Essência de Inferium"
	quest.42D64DB58ACA1C29.quest_desc: ["Reproduza duas abelhas diferentes com flores para ganhar abelhas novas. O JEI mostra todas as combinações."]
	quest.42D64DB58ACA1C29.title: "Reprodução"
	quest.431CE50C60F31B03.quest_desc: ["O Supercritical Phase Shifter transforma polônio em antimatéria. Ele precisa de uma quantidade enorme de energia."]
	quest.431CE50C60F31B03.title: "SPS"
	quest.435718249DBE023A.quest_desc: ["Uma pedreira mais rápida, com brocas melhores."]
	quest.435718249DBE023A.title: "Pedreira Elétrica"
	quest.4392FD9CE67CC3F4.quest_desc: ["Enxofre, salitre, sal e fluorita são usados em pólvora, química e no Mekanism."]
	quest.4392FD9CE67CC3F4.title: "Minerais"
	quest.43CD86AF50814484.quest_desc: ["Não existe ar no espaço. O Traje Espacial mantém você vivo, enquanto tiver oxigênio."]
	quest.43CD86AF50814484.title: "Traje Espacial"
	quest.43E3AA1233B802A1.quest_desc: ["As abelhas têm genes: produtividade, tolerância ao clima, comportamento. Extraia genes com uma Gene Bottle e combine."]
	quest.43E3AA1233B802A1.title: "Genes"
	quest.43E4936B9F385A02.quest_desc: ["Seis cavaleiros fantasmas na Goblin Knight Stronghold, na Floresta Escura."]
	quest.43E4936B9F385A02.title: "Cavaleiros Fantasmas"
	quest.43EE5E61C0DA08ED.quest_desc: ["Uma vassoura voadora que você monta por partes. Funciona com sangue."]
	quest.43EE5E61C0DA08ED.title: "Vassoura"
	quest.43F5A99E4171D7A0.quest_desc: ["Ferramentas de construção com energia: colocar, trocar, destruir e até copiar e colar construções inteiras."]
	quest.43F5A99E4171D7A0.title: "Building Gadgets"
	quest.449B6BFA4E39F3C8.quest_desc: ["Desmonte equipamentos com afixos em materiais de raridade."]
	quest.449B6BFA4E39F3C8.title: "Recuperação"
	quest.44AE8B8768FD013C.quest_desc: ["Armazenamento grande que pode ser colado em máquinas e trens."]
	quest.44AE8B8768FD013C.title: "Cofre de Itens"
	quest.44DCFB921255FCDF.quest_desc: ["Ligue as câmeras ao Camera Monitor e veja a sua base de qualquer lugar."]
	quest.44DCFB921255FCDF.title: "Câmeras"
	quest.44FDEB9C895F89B5.quest_desc: ["Coletam itens e fluidos numa área."]
	quest.44FDEB9C895F89B5.title: "Coletores"
	quest.45322430461483FD.quest_desc: ["Lã de ovelha e tábuas fazem uma cama. Dormir pula a noite e marca o seu ponto de renascimento."]
	quest.45322430461483FD.title: "Uma Cama"
	quest.453F5E9FE5CAAB88.quest_desc: ["Mostra qual veio mineral existe embaixo do chunk. Pegue a amostra para achar onde colocar a Escavadeira."]
	quest.453F5E9FE5CAAB88.title: "Core Sample Drill"
	quest.45402C80392BB30F.quest_desc: ["Enxergue o Outro Mundo sem comer Demon's Dream."]
	quest.45402C80392BB30F.title: "Otherworld Goggles"
	quest.4572A97974FB60FE.quest_desc: ["Coloque aberta perto de um Vengeance Spirit para capturá-lo."]
	quest.4572A97974FB60FE.title: "Box of Eternal Closure"
	quest.45BD6EBD7462D40E.quest_desc: ["O urânio é radioativo e alimenta reatores de fissão. Fica bem fundo e brilha verde."]
	quest.45BD6EBD7462D40E.title: "Urânio"
	quest.45C2A0646306F25E.quest_desc: ["Fabrique direto da rede."]
	quest.45C2A0646306F25E.title: "Crafting Grid"
	quest.45C4773275B80FAF.quest_desc: ["Motores a combustão grandes, com cilindros: muita rotação com gasolina ou diesel."]
	quest.45C4773275B80FAF.title: "Motores do TFMG"
	quest.45E30AAE4DDB47AF.quest_desc: ["Um gerenciador programável: escreva programas simples num disco para mover qualquer coisa para qualquer lugar."]
	quest.45E30AAE4DDB47AF.title: "Super Factory Manager"
	quest.45F26D965C6BFEF4.quest_desc: ["Suba em cordas como escadas. A Roldana enrola e desenrola a corda com redstone."]
	quest.45F26D965C6BFEF4.title: "Corda e Roldana"
	quest.46083782C112D669.quest_desc: ["Coleta itens e XP numa área."]
	quest.46083782C112D669.title: "Absorption Hopper"
	quest.463B2BEBA70DAF1A.quest_desc: ["Construa trilhos, uma estação e um trem. Um Train Schedule faz ele viajar entre as estações sozinho."]
	quest.463B2BEBA70DAF1A.title: "Trens"
	quest.465C8DB2A2A4436B.quest_desc: ["O Cataclysm adiciona chefões grandes em estruturas especiais. Use a Bússola do Explorador para achar."]
	quest.465C8DB2A2A4436B.title: "Os Chefões do Cataclysm"
	quest.467C146A7ED005E5.quest_desc: ["Foguetes e rovers são montados na NASA Workbench."]
	quest.467C146A7ED005E5.title: "NASA Workbench"
	quest.468DB5691CC767EA.quest_desc: ["O último nível. Ferramentas com muitas habilidades."]
	quest.468DB5691CC767EA.title: "Liga Eclipse"
	quest.46A35779A0DA2FF6.quest_desc: ["Cultiva qualquer plantação dentro dela com água e energia, sem espaço nem luz."]
	quest.46A35779A0DA2FF6.title: "Estufa"
	quest.46B4FCFDD172147A.quest_desc: ["Fazem a armadura da Naga."]
	quest.46B4FCFDD172147A.title: "Escamas da Naga"
	quest.46FAB5081510C998.quest_desc: ["O XyCraft World tem muitos blocos coloridos e brilhantes para construir."]
	quest.46FAB5081510C998.title: "Decoração"
	quest.471C9739196E6609.quest_desc: ["A arma mais forte do Scorched Guns."]
	quest.471C9739196E6609.title: "Flayed God"
	quest.4736893C01D14D6A.quest_desc: [
		"Você dominou todos os mods do Sujjs Legacy e criou o The Absolute."
		""
		"Obrigado por jogar! Feito com carinho pelo Sujjs Team."
	]
	quest.4736893C01D14D6A.quest_subtitle: "Obrigado por jogar"
	quest.4736893C01D14D6A.title: "&6&lSujjs Legacy Zerado!"
	quest.47378129DB098C4E.quest_desc: ["O Extendo Grip dá mais alcance. O Linked Controller manda sinais de redstone da sua mão."]
	quest.47378129DB098C4E.title: "Engenhocas"
	quest.478C5C35356D4823.quest_desc: ["Coloque o Goo e alimente: ele transforma os blocos ao lado. Cada nível de Goo faz materiais melhores."]
	quest.478C5C35356D4823.title: "Goo"
	quest.47B7C7E2ECC8F32E.quest_desc: ["Movem Source entre os jarros. Ligue com a Dominion Wand: clique primeiro na origem e depois no destino."]
	quest.47B7C7E2ECC8F32E.title: "Source Relays"
	quest.47C2FA21029363B9.quest_desc: ["Os blocos só se movem juntos se estiverem colados. Selecione dois cantos com a cola para grudar uma área."]
	quest.47C2FA21029363B9.title: "Super Cola"
	quest.4812A0F1F92C8F5A.quest_desc: ["Quebra o bloco na frente. Numa máquina móvel, vira uma tuneladora."]
	quest.4812A0F1F92C8F5A.title: "Broca Mecânica"
	quest.483689B7AC24B69D.quest_desc: ["Clique na terra arada com uma essência. Terras melhores dão chance de essência extra."]
	quest.483689B7AC24B69D.title: "Terra de Essência"
	quest.48F87893253E3376.quest_desc: ["Coloque e quebre blocos no mundo a partir da rede."]
	quest.48F87893253E3376.title: "Constructor e Destructor"
	quest.490F6A8CED0CDE86.quest_desc: ["Dispara hastes de metal em alta velocidade com eletricidade."]
	quest.490F6A8CED0CDE86.title: "Railgun"
	quest.494B158D8DFB78BC.quest_desc: ["O XyCraft Machines adiciona tanques e armazenamento em estruturas. Use o JEI para ver os formatos."]
	quest.494B158D8DFB78BC.title: "Máquinas do XyCraft"
	quest.49D489EA32F4DE61.quest_desc: ["Aprenda novos glifos aqui, pagando com os itens mostrados."]
	quest.49D489EA32F4DE61.title: "Mesa do Escriba"
	quest.49DC7D11A8B0F268.quest_desc: [
		"O PneumaticCraft usa ar comprimido. O compressor queima combustível para fazer ar; os Pressure Tubes levam o ar."
		"&cPressão demais explode as máquinas!"
	]
	quest.49DC7D11A8B0F268.title: "Compressor de Ar"
	quest.4A11B5446E9F585E.quest_desc: ["Vive na Ruined Citadel no End."]
	quest.4A11B5446E9F585E.title: "Ender Guardian"
	quest.4A34368D409E27AD.quest_desc: ["As usinas são guardadas por Soldados Irradiados. Derrote 10 deles."]
	quest.4A34368D409E27AD.title: "Soldados Irradiados"
	quest.4A86E565CCC4CFB8.quest_desc: ["Coloque melhorias de Speed e Energy na aba de melhorias da máquina. Speed gasta muito mais energia; Energy compensa."]
	quest.4A86E565CCC4CFB8.title: "Melhorias"
	quest.4A9972F9317F3C9E.quest_desc: ["O quarto nível."]
	quest.4A9972F9317F3C9E.title: "Imperium"
	quest.4A9C0F88BBDD4F21.quest_desc: ["Guarda uma quantidade enorme de um item ou fluido."]
	quest.4A9C0F88BBDD4F21.title: "Armazenamento Buraco Negro"
	quest.4ABAE24BDD41E02F.quest_desc: ["Na Yeti Cave da Floresta Nevada. A pele dele faz armadura contra o frio."]
	quest.4ABAE24BDD41E02F.title: "Alpha Yeti"
	quest.4B38B4CD73F9EF2F.quest_desc: ["O melhor traje espacial: aguenta o calor, guarda oxigênio e deixa você voar."]
	quest.4B38B4CD73F9EF2F.title: "Jet Suit"
	quest.4B4CEBB7769B2E0D.quest_desc: ["Armadura e sabre com energia, antes do nível Quantum."]
	quest.4B4CEBB7769B2E0D.title: "Traje Nano"
	quest.4B6694507E67765C.quest_desc: ["Feitos no Soul Binder. Usados nos melhores capacitores."]
	quest.4B6694507E67765C.title: "Cristais"
	quest.4BB62746A76E9BCA.quest_desc: ["Um spawner que funciona com energia, usando uma alma capturada num Soul Vial."]
	quest.4BB62746A76E9BCA.title: "Powered Spawner"
	quest.4BD431470C01530E.quest_desc: ["Tanques de Fluido com um Distillation Controller e calor separam o petróleo em diesel, gasolina e mais."]
	quest.4BD431470C01530E.title: "Destilação"
	quest.4BDFEB252B52B702.quest_desc: ["Foguetes só decolam de uma Launch Pad."]
	quest.4BDFEB252B52B702.title: "Plataforma de Lançamento"
	quest.4BF073D965EFEA51.quest_desc: ["O Control Stand do Aeroworks com módulos (manche, joystick, acelerador, pedais) é como você pilota o seu veículo."]
	quest.4BF073D965EFEA51.title: "Cabine"
	quest.4C542F63AE936851.quest_desc: ["Com um Backtank, o capacete de mergulho deixa respirar embaixo d'água. O conjunto de netherite deixa andar na lava."]
	quest.4C542F63AE936851.title: "Equipamento de Mergulho"
	quest.4C594C5A0FD6D267.quest_desc: ["A chefona da tempestade, na Acropolis."]
	quest.4C594C5A0FD6D267.title: "Scylla"
	quest.4C6117507D2D392E.quest_desc: ["Da Netherite Monstrosity. Um martelo que treme o chão."]
	quest.4C6117507D2D392E.title: "Infernal Forge"
	quest.4C88DC5FF63C919F.quest_desc: ["Apothic Spawners: quebre um spawner com Toque Suave e clique nele com itens para mudar velocidade, alcance e mais."]
	quest.4C88DC5FF63C919F.title: "Melhorias de Spawner"
	quest.4C8AD29F272C6750.quest_desc: ["Os cartões vão dentro dos barramentos e interfaces: mais velocidade, mais filtros, comparação aproximada."]
	quest.4C8AD29F272C6750.title: "Cartões de Melhoria"
	quest.4CA3AAA1ACFE58A2.quest_desc: ["As gemas do XyCraft existem em cinco cores, achadas no subsolo."]
	quest.4CA3AAA1ACFE58A2.title: "Xychorium"
	quest.4CC64B0AC96753C6.quest_desc: ["Os baús do Lootr dão loot próprio para cada jogador, então você nunca acha um baú vazio deixado por um amigo."]
	quest.4CC64B0AC96753C6.title: "Loot Compartilhado"
	quest.4CD6F2E65164C512.quest_desc: ["Coloque um catalisador na frente do ventilador para escolher o processamento sem lava nem água."]
	quest.4CD6F2E65164C512.title: "Catalisadores de Ventilador"
	quest.4CDFAFBB23E387C8.quest_desc: ["As hélices de Andesito e Inteligentes são mais fortes, e o Gyroscopic Propeller Bearing mantém a hélice apontada para onde você quer."]
	quest.4CDFAFBB23E387C8.title: "Hélices Melhores"
	quest.4DB0F6CED65758F9.quest_desc: ["Bombeia água para sempre de uma fonte embaixo dela. Com um Filter Upgrade, dá Água Pesada."]
	quest.4DB0F6CED65758F9.title: "Bomba Elétrica"
	quest.4DE68B32BB6D63C4.quest_desc: ["Comprime materiais com TNT Industrial. Mais tarde ele refaz o The Absolute a partir de 46 fragmentos."]
	quest.4DE68B32BB6D63C4.title: "Implosion Compressor"
	quest.4E69BFBDD55DFD56.quest_desc: ["O Pyromancer atira fogo, o Ender joga pérolas, o Sojourner coloca tochas de longe."]
	quest.4E69BFBDD55DFD56.title: "Cajados"
	quest.4F03D4D5903C5D21.quest_desc: ["Um Hot Air Burner embaixo de Hot Air Envelopes levanta o seu dirigível. Mais calor, mais subida."]
	quest.4F03D4D5903C5D21.title: "Balão de Ar Quente"
	quest.4F39335042358FF4.quest_desc: ["Uma dimensão sob um céu estrelado eterno. Monte a moldura do portal com os blocos do mod e atravesse."]
	quest.4F39335042358FF4.title: "Eternal Starlight"
	quest.4FA6B51369843D4A.quest_desc: ["Impede monstros de nascer numa área grande em volta. Perfeita para a sua base."]
	quest.4FA6B51369843D4A.title: "Mega Tocha"
	quest.4FE4E82211A92620.quest_desc: ["O Goo também transforma carvão em combustíveis melhores."]
	quest.4FE4E82211A92620.title: "Gerador e Combustível"
	quest.50921A400FCF47DE.quest_desc: ["Guarde energia FE em células e entregue às máquinas pela rede com o Flux Accessor."]
	quest.50921A400FCF47DE.title: "Applied Flux"
	quest.51024F5E8E5BC840.quest_desc: ["O Magmator queima lava. O Thermo Generator precisa de uma fonte de calor embaixo e água dentro."]
	quest.51024F5E8E5BC840.title: "Magmator e Thermo"
	quest.51228782A12C83CF.quest_desc: ["O Spout enche baldes, garrafas e itens na esteira. O Item Drain esvazia."]
	quest.51228782A12C83CF.title: "Spout e Drain"
	quest.517F6C41ADA9C257.quest_desc: [
		"O Nucleon também existe como fluido. Coloque um Fluid Laser Drill do Industrial Foregoing para trabalhar com um Nucleon por perto para coletar."
		""
		"O The Absolute pede 1.800.000 mB."
	]
	quest.517F6C41ADA9C257.title: "Fluido Nucleon"
	quest.51840CFCC1F690B7.quest_desc: ["Gira tudo o que está colado nele. Com velas coladas num Windmill Bearing, gera rotação com o vento."]
	quest.51840CFCC1F690B7.title: "Rolamento Mecânico"
	quest.518B9A8F1ADA869D.quest_desc: ["Cooking for Blockheads: a Mesa de Cozinha mostra toda receita que dá para fazer com o que tem na sua cozinha."]
	quest.518B9A8F1ADA869D.title: "Mesa de Cozinha"
	quest.51A4C4317820B3B5.quest_desc: ["Sorteie de novo a raridade e os afixos do equipamento com materiais e níveis."]
	quest.51A4C4317820B3B5.title: "Reforja"
	quest.51B337AD71769F3D.quest_desc: ["Coloque em cima de uma fonte de calor (fogueira, fogão ou fogo) e ponha os ingredientes dentro. As refeições dão efeitos longos."]
	quest.51B337AD71769F3D.title: "Panela"
	quest.51C10C495813D66A.quest_desc: ["Use um Sigil of Socketing na Mesa de Ferraria para adicionar um encaixe ao equipamento."]
	quest.51C10C495813D66A.title: "Mais Encaixes"
	quest.51E9F54CFBEE0F84.quest_desc: ["Um cajado para canalizar a sua magia."]
	quest.51E9F54CFBEE0F84.title: "Cajado Místico"
	quest.524DB2F5BEDD40E5.quest_desc: ["O TFMG traz a indústria pesada ao Create: fornos de coque, altos-fornos de aço, petróleo, plástico e motores grandes."]
	quest.524DB2F5BEDD40E5.title: "The Factory Must Grow"
	quest.525AEDA352361E59.quest_desc: ["Ache árvores de Menril e esprema as toras no Squeezer (ou numa Drying Basin) para pegar a Resina de Menril."]
	quest.525AEDA352361E59.title: "Menril"
	quest.52B48EE6C578C6D1.quest_desc: ["Dark Steel (ferro + carvão + obsidiana), Vibrant Alloy (Energetic Alloy + pérola do ender) e End Steel."]
	quest.52B48EE6C578C6D1.title: "Ligas do Ender IO"
	quest.52C7CBBEF4DE3FB9.quest_desc: ["Cozinhe um Ensopado de Carne. As refeições da Panela enchem muito mais que comida crua."]
	quest.52C7CBBEF4DE3FB9.title: "Uma Refeição de Verdade"
	quest.52D55B7BE7CFE0E4.quest_desc: ["O melhor material de bobina para turbinas."]
	quest.52D55B7BE7CFE0E4.title: "Ludicrita"
	quest.52EFBE9EB61FEAF6.quest_desc: ["Fabrica receitas sozinho."]
	quest.52EFBE9EB61FEAF6.title: "Crafter"
	quest.530F0D36C1D009D8.quest_desc: ["Acenda uma fruta Demon's Dream no chão. Jogue itens dentro: diamantes viram Spirit Attuned Gems, e assim por diante."]
	quest.530F0D36C1D009D8.title: "Spirit Fire"
	quest.531B85F2ABFBCF8D.quest_desc: ["Um ventilador soprando através de água lava os itens, através de lava ou fogo derrete, através de fogo das almas assombra."]
	quest.531B85F2ABFBCF8D.title: "Processamento em Massa"
	quest.531DB8AD2B9AF176.quest_desc: ["Use num espaço do Curios. Cada recipiente dentro dá corações: vermelho dos mobs, amarelo dos chefões, verde dos dragões, azul do Warden."]
	quest.531DB8AD2B9AF176.title: "Amuleto de Coração"
	quest.535B86EF0C945441.quest_desc: ["Use na bancada com 4 essências para subir o nível. O Master Infusion Crystal nunca quebra."]
	quest.535B86EF0C945441.title: "Infusion Crystal"
	quest.5393B95BC1057F8C.quest_desc: ["Aperte M para abrir o mapa do mundo e B para criar um marcador. Quando você morre, um marcador mostra o lugar."]
	quest.5393B95BC1057F8C.title: "Mapa e Marcadores"
	quest.53B692E2D3AA5B2F.quest_desc: ["Mata mobs na área e coleta os drops e a experiência como Essence."]
	quest.53B692E2D3AA5B2F.title: "Mob Crusher"
	quest.53CEE625EE8B6674.quest_desc: ["Duas Rodas Trituradoras girando uma contra a outra trituram minérios muito mais rápido que o Moinho, com bônus."]
	quest.53CEE625EE8B6674.title: "Rodas Trituradoras"
	quest.53DA5EAC7340DCEC.quest_desc: ["O Integrated Dynamics lê informações do mundo por cabos e Readers, e age com Writers."]
	quest.53DA5EAC7340DCEC.title: "Cabos Lógicos"
	quest.53E69BC03930BC04.quest_desc: ["As ligas Infused (redstone), Reinforced (diamante) e Atomic (obsidiana refinada) fazem os níveis de circuitos e máquinas."]
	quest.53E69BC03930BC04.title: "Ligas"
	quest.541E9BB7062A206B.quest_desc: ["Enchantment Industry: o Mechanical Grindstone transforma itens em experiência líquida."]
	quest.541E9BB7062A206B.title: "Experiência Líquida"
	quest.542E80679EFD4C6B.quest_desc: ["Um baú que só o dono abre, e que explosões não quebram."]
	quest.542E80679EFD4C6B.title: "Cofre"
	quest.549CD1AB9AE70A24.quest_desc: ["Usa almas de mobs capturadas (em Soul Vials) para fazer itens especiais."]
	quest.549CD1AB9AE70A24.title: "Soul Binder"
	quest.54B5420B5D29FEFA.quest_desc: ["Na Bumblezone, leve à Abelha Rainha os itens que ela pede e ela dá recompensas."]
	quest.54B5420B5D29FEFA.title: "A Abelha Rainha"
	quest.54CDEFDAA17D76D3.quest_desc: ["Fique em cima de uma, olhe para outra e pule (ou agache) para teleportar."]
	quest.54CDEFDAA17D76D3.title: "Travel Anchors"
	quest.54D054C155E4A916.quest_desc: ["Faça o controlador do Reator Absoluto na bancada: Blocos de Irídio, Blocos de Netherite, Carcaças do SPS e um Frasco Radioativo."]
	quest.54D054C155E4A916.title: "Controlador do Reator Absoluto"
	quest.54DE5AFCE78C9643.quest_desc: ["Picareta, machado e pá numa só, com todas as habilidades."]
	quest.54DE5AFCE78C9643.title: "Eclipse Paxel"
	quest.5560BA2A2BC42416.quest_desc: ["Empurram e puxam estruturas coladas em linha. Usados em portas, brocas e elevadores."]
	quest.5560BA2A2BC42416.title: "Pistões e Pórticos"
	quest.55C8CA7DCFB92FF2.quest_desc: ["Mais caixas de engrenagens, embreagens, freios e o Item Silo e o Fluid Vessel."]
	quest.55C8CA7DCFB92FF2.title: "Create: Connected"
	quest.562952C5BD26CB8B.quest_desc: ["Carrega o Quartzo Certus. Jogue certus carregado, redstone e quartzo do nether na água para fazer Cristais Fluix."]
	quest.562952C5BD26CB8B.title: "Carregador"
	quest.5667B25B12083F5C.quest_desc: [
		"O Create Aeronautics, o Simulated e os addons deles transformam as máquinas do Create em veículos de verdade, com física: dirigíveis, aviões, carros e tanques."
		""
		"O Physics Assembler transforma uma máquina do Create num veículo com física."
	]
	quest.5667B25B12083F5C.quest_subtitle: "Construa o que voa e o que anda"
	quest.5667B25B12083F5C.title: "Create Aeronautics"
	quest.566F9B747F3AB2B8.quest_desc: ["Mata mobs com dano de jogador, então eles soltam itens raros e XP. Adicione melhorias de Looting e Beheading."]
	quest.566F9B747F3AB2B8.title: "Mob Masher"
	quest.56D8B78345BD7C2A.quest_desc: ["Electrum (ouro + prata), Invar (ferro + níquel) e Constantan (cobre + níquel). Faça em qualquer fundidor de ligas."]
	quest.56D8B78345BD7C2A.title: "Ligas"
	quest.57086556A63797DC.quest_desc: ["Torretas automáticas defendem a sua base. Dê munição a elas."]
	quest.57086556A63797DC.title: "Torretas"
	quest.571C2E89A128D964.quest_desc: ["Uma espada lendária."]
	quest.571C2E89A128D964.title: "Caliburn"
	quest.580D613CB803A867.quest_desc: ["Clique em blocos com ele para transformá-los, como criar a Forja de Hefesto."]
	quest.580D613CB803A867.title: "Pó de Mundabitur"
	quest.580DD70F8B4B8CAB.quest_desc: ["3 cobres + 1 estanho fazem bronze em qualquer máquina de ligas, ou misture os pós num Mixer do Create."]
	quest.580DD70F8B4B8CAB.title: "Bronze"
	quest.58290A2DE53967C8.quest_desc: ["Um traje Hazmat completo protege você. O Geiger Counter mostra a radiação. Guarde o lixo em Radioactive Waste Barrels."]
	quest.58290A2DE53967C8.title: "Proteção contra Radiação"
	quest.584B03EEF07BA8BA.quest_desc: ["O segundo nível."]
	quest.584B03EEF07BA8BA.title: "Blazegold"
	quest.584F4631E7327748.quest_desc: ["Circuitos Advanced, Elite e Ultimate: cada um é o circuito anterior mais a próxima liga."]
	quest.584F4631E7327748.title: "Circuitos Melhores"
	quest.5891CB3055EEFCC8.quest_desc: ["O Reliquary adiciona relíquias mágicas como a Mercy Cross, o Angelheart Vial e a Midas Touchstone."]
	quest.5891CB3055EEFCC8.title: "Reliquary"
	quest.589DCEF61FB692A8.quest_desc: ["Mostra quais chunks têm petróleo embaixo. Construa um Pumpjack em cima para extrair."]
	quest.589DCEF61FB692A8.title: "Scanner de Petróleo"
	quest.58A5056C44169A1C.quest_desc: ["O Flight Module num Environmental Controller deixa você voar numa área."]
	quest.58A5056C44169A1C.title: "Voo"
	quest.58C1C7F8AE1D5245.quest_desc: ["Canhões de aço e Nethersteel aguentam mais cargas de pólvora e atiram bem mais longe."]
	quest.58C1C7F8AE1D5245.title: "Canhões de Aço"
	quest.59389CC557A54E02.quest_desc: ["Usadas nos reatores do Oritech e no Low-Yield Nuke."]
	quest.59389CC557A54E02.title: "Pastilhas de Urânio"
	quest.596FE926B2E29BE6.quest_desc: ["Transforma o vapor do reator em muita energia."]
	quest.596FE926B2E29BE6.title: "Turbina Industrial"
	quest.59AE02A80E9E9788.quest_desc: ["Clique nos blocos com o Reinforcer: eles ficam inquebráveis para todos, menos para você."]
	quest.59AE02A80E9E9788.title: "Blocos Reforçados"
	quest.59E06D63FE4F610D.quest_desc: ["Cozinha comida sobre o calor, e serve de arma."]
	quest.59E06D63FE4F610D.title: "Frigideira"
	quest.59F1C074E12889DE.quest_desc: ["O Ore Magnet puxa minérios para a superfície. A Uncrafting Table desmonta itens."]
	quest.59F1C074E12889DE.title: "Achados Úteis"
	quest.59FE699D565F6573.quest_desc: ["Junte gemas e Gem Dust para subir a qualidade de uma gema."]
	quest.59FE699D565F6573.title: "Lapidação"
	quest.5A21EA2D3B15AC61.quest_desc: [
		"Andesito + pepita de ferro (ou zinco). É a base de tudo no Create."
		"&eO Create funciona com rotação: uma fonte gira eixos e engrenagens, e as máquinas usam essa rotação."
	]
	quest.5A21EA2D3B15AC61.title: "Liga de Andesito"
	quest.5A34147F674229D0.quest_desc: ["Encontra ninhos naturais do tipo que você escolher."]
	quest.5A34147F674229D0.title: "Localizador de Ninhos"
	quest.5A6F2931C9CBC87E.quest_desc: ["Chemical Reactor, Centrifuge e Electrolyzer processam fluidos em plásticos, borracha e gases."]
	quest.5A6F2931C9CBC87E.title: "Química"
	quest.5A9F6D8FBB663B6C.quest_desc: ["O Annihilation Plane quebra blocos para dentro da rede; o Formation Plane coloca."]
	quest.5A9F6D8FBB663B6C.title: "Planos"
	quest.5AA851C77DEB7324.quest_desc: ["Energia simples e grátis durante o dia."]
	quest.5AA851C77DEB7324.title: "Painéis Solares"
	quest.5AACDA415D6967F1.quest_desc: ["Fabrique a partir da rede e escreva Padrões para a fabricação automática."]
	quest.5AACDA415D6967F1.title: "Crafting Terminal"
	quest.5AB0749196C81EA9.quest_desc: ["As Iron Furnaces derretem mais rápido. Use kits de melhoria para trocar uma fornalha por uma melhor."]
	quest.5AB0749196C81EA9.title: "Fornalhas Melhores"
	quest.5ADFC6CDF864330D.quest_desc: ["Dê uma pepita de ouro a um Starbuncle selvagem para ganhar um fragmento, faça o amuleto e ele leva itens entre baús para você."]
	quest.5ADFC6CDF864330D.title: "Starbuncles"
	quest.5AE9957E0FE0A8B4.quest_desc: ["Dois aldeões e comida dentro fazem bebês aldeões."]
	quest.5AE9957E0FE0A8B4.title: "Reprodutor"
	quest.5AF1FE41FA0653F6.quest_desc: ["As estantes superiores sobem o limite de nível até 100."]
	quest.5AF1FE41FA0653F6.title: "Estantes do Mar e do End"
	quest.5AFA4808A31C4EBD.quest_desc: ["Cano + câmara + culatra, em linha. Quanto mais longo o cano, mais longe ele atira."]
	quest.5AFA4808A31C4EBD.title: "Um Canhão"
	quest.5B6A8A3D2E9FA040.quest_desc: ["O Crafting Storage decide o tamanho do pedido; os Accelerators deixam mais rápido. Monte uma CPU para cada pedido simultâneo."]
	quest.5B6A8A3D2E9FA040.title: "CPU de Crafting"
	quest.5B7BCBB67B80DC3F.quest_desc: ["Milhões de FE por tick, mas &cextremamente perigoso&r: se o campo falhar, ele explode. Ele alimenta o Reator Absoluto."]
	quest.5B7BCBB67B80DC3F.title: "&cReator Dracônico"
	quest.5BF4ACB5D1C825DE.quest_desc: ["Energia sem fio: IO Crystals nas máquinas, Relay Crystals no meio. Ligue com o Crystal Binder."]
	quest.5BF4ACB5D1C825DE.title: "Cristais de Energia"
	quest.5C356A5382D4B96D.quest_desc: ["Pouse em Vênus, o planeta da chuva ácida."]
	quest.5C356A5382D4B96D.title: "Vênus"
	quest.5C7EFEB5BB4ED602.quest_desc: ["A Meteorite Compass aponta para os meteoritos do AE2, que guardam as prensas de processador."]
	quest.5C7EFEB5BB4ED602.title: "Meteoritos"
	quest.5C86295742DF5517.quest_desc: ["O último nível de circuito. É usado no Controlador Dimensional e no The Absolute."]
	quest.5C86295742DF5517.title: "&5Circuito Quântico"
	quest.5C8C652E108305C2.quest_desc: ["Uma grade de Mechanical Crafters faz receitas grandes sozinha, como a Bomba Atômica."]
	quest.5C8C652E108305C2.title: "Mechanical Crafters"
	quest.5CA8DE86548A3984.quest_desc: ["Uma broca que minera áreas enormes, com energia. Carregue no Infinity Charger."]
	quest.5CA8DE86548A3984.title: "Infinity Drill"
	quest.5D13BD126C44C698.quest_desc: ["Os Range Addons aumentam a área de trabalho. Os de Speed e Efficiency deixam as máquinas mais rápidas e baratas."]
	quest.5D13BD126C44C698.title: "Addons de Máquina"
	quest.5D2EA24EE1848787.quest_desc: ["Movem itens sem energia."]
	quest.5D2EA24EE1848787.title: "Esteiras"
	quest.5D3A7EDB94021C7E.quest_desc: ["Morgan e Clarent, as espadas sombria e rebelde."]
	quest.5D3A7EDB94021C7E.title: "Lâminas Lendárias"
	quest.5D502CEC000B870E.quest_desc: [
		"{image:kubejs:textures/quests/altar_radioativo.png width:256 height:144 align:center}"
		""
		"Dentro das usinas existe um Altar Radioativo, no centro de uma arena redonda."
		""
		"Clique nele com o botão direito segurando um Cristal de Fogo para começar o ritual. O céu fica verde, e o Nucleon desperta."
	]
	quest.5D502CEC000B870E.title: "O Altar Radioativo"
	quest.5DDFE1C39F24F325.quest_desc: ["Cada aparelho usa 1 canal. Um cabo normal leva 8, um cabo denso leva 32. O Controlador dá 32 canais por lado."]
	quest.5DDFE1C39F24F325.title: "Cabos e Canais"
	quest.5DE012FDD82B061B.quest_desc: ["Encontre minério de ferro nas cavernas, derreta e faça uma picareta de ferro. A maioria dos mods começa aqui."]
	quest.5DE012FDD82B061B.title: "Idade do Ferro"
	quest.5E0C8AA95068FB36.quest_desc: ["Monte a moldura em volta do Teleporter e escolha uma frequência. O Portable Teleporter leva você a qualquer um."]
	quest.5E0C8AA95068FB36.title: "Teleportador"
	quest.5E0CB93FAFF337E3.quest_desc: ["Melhorias para as máquinas do EvilCraft: níveis e velocidade."]
	quest.5E0CB93FAFF337E3.title: "Promessas"
	quest.5E0E5565BB871EAB.quest_desc: [
		"{image:kubejs:textures/quests/nucleon.png width:256 height:144 align:center}"
		""
		"Derrote o Nucleon. Ele se protege com um escudo radioativo: quebre o escudo para acertar o chefão."
		""
		"É uma luta difícil: leve o seu melhor equipamento, cura e muita munição."
	]
	quest.5E0E5565BB871EAB.quest_subtitle: "O chefão radioativo"
	quest.5E0E5565BB871EAB.title: "&cO Nucleon"
	quest.5E108F3229886E41.quest_desc: ["Uma bateria gigante feita de blocos em volta do Energy Core. Ela pode guardar trilhões de energia."]
	quest.5E108F3229886E41.title: "Energy Core"
	quest.5E56A26D1DCD86E6.quest_desc: ["O melhor equipamento do Mekanism. Adicione módulos na Modification Station."]
	quest.5E56A26D1DCD86E6.title: "MekaSuit e Meka-Tool"
	quest.5EB39398DC375AAB.quest_desc: ["Carrega muita munição e alimenta as suas armas."]
	quest.5EB39398DC375AAB.title: "Caixa de Munição"
	quest.5ED50008955104C9.quest_desc: ["Transforma placas em fios e hastes."]
	quest.5ED50008955104C9.title: "Laminador"
	quest.5F35F737556FEAF4.quest_desc: [
		"Este livro guia você por todos os mods do modpack, da primeira árvore até o The Absolute."
		"Cada quest explica o que fazer e como, então você nunca precisa de tutorial de fora. Use o JEI (lista de itens à direita) para ver a receita de qualquer coisa: passe o mouse no item e aperte R."
	]
	quest.5F35F737556FEAF4.title: "Bem-vindo ao Sujjs Legacy!"
	quest.5F8FA59028B0537B.quest_desc: ["A bomba grande do Oritech. É usada no The Absolute."]
	quest.5F8FA59028B0537B.title: "&cManhattan Module"
	quest.5FA2CF76510EF2D7.quest_desc: ["Esquente petróleo na Refinery para separar em Diesel, Querosene, Gasolina e LPG."]
	quest.5FA2CF76510EF2D7.title: "Refinaria"
	quest.5FC4BA9BD32F9986.quest_desc: ["Do Leviathan. Agarre mobs de longe."]
	quest.5FC4BA9BD32F9986.title: "Tidal Claws"
	quest.603A0FD93CA366F3.quest_desc: ["Energia grátis durante o dia."]
	quest.603A0FD93CA366F3.title: "Painel Solar"
	quest.605D5171CB8890D4.quest_desc: [
		"Feita no Assembler do Modern Industrialization, a 512 EU/t, com Irídio, Plasma Core, Liga Atômica, Polônio, um Ultimate Control Circuit, Cryofluid e Tritium."
		""
		"É a base de toda a munição de fim de jogo. Automatize cedo: as receitas finais pedem centenas."
	]
	quest.605D5171CB8890D4.quest_subtitle: "Serve em qualquer arma"
	quest.605D5171CB8890D4.title: "Munição Universal"
	quest.605FD4503B0B8AA0.quest_desc: ["A base de toda máquina. Molduras melhores (Simple, Advanced, Supreme) fazem máquinas melhores."]
	quest.605FD4503B0B8AA0.title: "Moldura Pity"
	quest.607CACD3BF1EFE3D.quest_desc: ["O guia do Mahou Tsukai explica cada escola de magia."]
	quest.607CACD3BF1EFE3D.title: "Guia"
	quest.617EEE706E3B790B.quest_desc: ["Um gerador simples para as primeiras máquinas."]
	quest.617EEE706E3B790B.title: "Gerador a Carvão"
	quest.61B76E150801405E.quest_desc: ["Treine um Data Model matando mobs e depois simule na Simulation Chamber para farmar os drops sem matar nada."]
	quest.61B76E150801405E.title: "Hostile Neural Networks"
	quest.61C52FC1DFCEC29E.quest_desc: ["Queima combustível para energia. O Powah também tem Magmators (lava), Painéis Solares e Thermo Generators."]
	quest.61C52FC1DFCEC29E.title: "Furnator"
	quest.61F077AFE3E3F988.quest_desc: ["Dois Laser Blocks de frente um para o outro fazem um sensor. Ligue a um Alarme."]
	quest.61F077AFE3E3F988.title: "Lasers e Alarmes"
	quest.61FC9A7C0F786B6B.quest_desc: ["Uma estrutura: coloque o controlador e siga o holograma (clique com a chave) para ver os blocos."]
	quest.61FC9A7C0F786B6B.title: "Forno de Coque"
	quest.6285CA2497631681.quest_desc: ["Coloque o canhão no suporte e gire com rotação para mirar."]
	quest.6285CA2497631681.title: "Suporte de Canhão"
	quest.62B6221BFE1556DD.quest_desc: ["Quando você morre, os itens ficam num túmulo onde você caiu. Volte e abra para recuperar tudo."]
	quest.62B6221BFE1556DD.title: "O Seu Túmulo"
	quest.62BCDA8E1CC2AEBD.quest_desc: ["Uma bomba nuclear pequena. Acenda com cuidado."]
	quest.62BCDA8E1CC2AEBD.title: "Low-Yield Nuke"
	quest.62DF1079D8496F42.quest_desc: ["O metal do Mekanism."]
	quest.62DF1079D8496F42.title: "Ósmio"
	quest.6300D481B0279DEE.quest_desc: ["Os HE Shells explodem no impacto. Adicione espoletas para escolher quando explodem."]
	quest.6300D481B0279DEE.title: "Projéteis Explosivos"
	quest.632BD217E2C29AC7.quest_desc: ["Uma CPU de crafting gigante que roda muitos pedidos ao mesmo tempo."]
	quest.632BD217E2C29AC7.title: "Computador Quântico"
	quest.6382182F5B3E8601.quest_desc: ["O Ironwood é ferro + Liveroot + ouro. O Steeleaf fica nos baús dos labirintos."]
	quest.6382182F5B3E8601.title: "Ironwood e Steeleaf"
	quest.63B72FF76DA8D20C.quest_desc: ["Clique na conexão do cano com a chave para escolher entrada ou saída. As cores separam as redes."]
	quest.63B72FF76DA8D20C.title: "Canos"
	quest.63D32B2A49696DAE.quest_desc: ["Refina petróleo em combustível e plástico."]
	quest.63D32B2A49696DAE.title: "Refinaria"
	quest.642059A69C825190.quest_desc: ["Os Logistical Transporters levam itens, os Mechanical Pipes levam fluidos e os Pressurized Tubes levam gases."]
	quest.642059A69C825190.title: "Transporte"
	quest.642F4CBA0F741823.quest_desc: ["Dá sinal só quando o dono olha para ele."]
	quest.642F4CBA0F741823.title: "Leitor de Retina"
	quest.645B7C5706B9F0BA.quest_desc: ["Roda várias cópias de uma mesma máquina numa estrutura só."]
	quest.645B7C5706B9F0BA.title: "Processing Array"
	quest.646FEC75BD9B5337.quest_desc: ["Feito com Chaos Shards do Chaos Guardian. Usado no Controlador Dimensional e no The Absolute."]
	quest.646FEC75BD9B5337.title: "&4Núcleo Caótico"
	quest.6490732DA5C1981A.quest_desc: ["A UU Matter vem do fim de jogo do MI. O Replicador copia qualquer item com ela. O The Absolute precisa de 112.500 mB."]
	quest.6490732DA5C1981A.title: "UU Matter e Replicador"
	quest.652A54175F5B8307.quest_desc: ["Copia livros encantados, livros escritos e schedules usando experiência."]
	quest.652A54175F5B8307.title: "Impressora"
	quest.652A5A11548DC760.quest_desc: ["Os pneus e suportes do Offroad transformam uma máquina num carro."]
	quest.652A5A11548DC760.title: "Rodas"
	quest.6578547D5C2FA0C6.quest_desc: ["Source Gems com itens em pedestais em volta da Imbuement Chamber viram essências elementais."]
	quest.6578547D5C2FA0C6.title: "Essências"
	quest.658E7FC4E04DCAF3.quest_desc: ["Vêm do minério de Prosperidade. Usados nas bases de sementes e nos Infusion Crystals."]
	quest.658E7FC4E04DCAF3.title: "Fragmentos de Prosperidade"
	quest.6595FA215E760D1C.quest_desc: ["O guerreiro amaldiçoado da Frosted Prison."]
	quest.6595FA215E760D1C.title: "Maledictus"
	quest.65A13EC2D05D2CB8.quest_desc: ["O melhor livro de feitiços: o máximo de glifos e mana. Derrote a Wilden Chimera para pegar as partes dela."]
	quest.65A13EC2D05D2CB8.title: "Livro de Arquimago"
	quest.65A845D55E821C48.quest_desc: ["Vento (melhor no alto), Solar e Bio (queima Bio Fuel do Crusher)."]
	quest.65A845D55E821C48.title: "Mais Geradores"
	quest.65B6254A10C42134.quest_desc: ["Guarda a Burning Arena no Nether. Ele derruba o Cristal de Fogo (50% de chance), necessário para o ritual do Nucleon."]
	quest.65B6254A10C42134.title: "Ignited Revenant"
	quest.65B66A522CC11B29.quest_desc: ["Crimson Steel (do Nether) e Azure Electrum (do End) são materiais de topo. O Tyrian Steel junta os dois."]
	quest.65B66A522CC11B29.title: "Ligas do Silent Gear"
	quest.65E288497646BCFB.quest_desc: ["Telhados, janelas, portas, pontes, cercas, luzes e móveis para a sua casa."]
	quest.65E288497646BCFB.title: "Macaw's"
	quest.65F62C8C57F7AABE.quest_desc: ["Supplementaries: as Jarras guardam fluidos, biscoitos e até mobs pequenos. Os Sacos são pequenos baús portáteis."]
	quest.65F62C8C57F7AABE.title: "Jarras e Sacos"
	quest.6606E37ECEEAC6E2.quest_desc: ["As esteiras levam itens entre as máquinas. Use a esteira entre dois eixos e coloque as máquinas em cima."]
	quest.6606E37ECEEAC6E2.title: "Esteiras e Depots"
	quest.6614C4A6FEC1D20D.quest_desc: ["Mystical Agradditions: o sexto nível. O Bloco de Insanium é usado no The Absolute."]
	quest.6614C4A6FEC1D20D.title: "&5Insanium"
	quest.66154E462C993C55.quest_desc: ["Mande itens, fluidos e energia por qualquer distância por canal."]
	quest.66154E462C993C55.title: "Ender Transmission"
	quest.6644971D6C1866B5.quest_desc: ["Chega a temperaturas mais altas para metais mais duros. Bobinas melhores dão mais calor."]
	quest.6644971D6C1866B5.title: "Alto-Forno Elétrico"
	quest.666A7EB2178ACE7A.quest_desc: ["Minera só os minérios que você filtrar, num raio grande, sem deixar buracos na superfície."]
	quest.666A7EB2178ACE7A.title: "Digital Miner"
	quest.667352B762AF6DD1.quest_desc: ["Pias, balcões, armários, geladeiras e fornos encostados formam uma cozinha só. A Mesa de Cozinha usa tudo o que está dentro deles."]
	quest.667352B762AF6DD1.title: "Uma Cozinha Completa"
	quest.670A6061A9C004D8.quest_desc: ["Do Harbinger. Faz a Wither Assault Shoulder Weapon, um lançador de mísseis."]
	quest.670A6061A9C004D8.title: "Witherite"
	quest.6760917F3037BAB3.quest_desc: ["O Lich solta um cetro: o Twilight atira, o Life Drain cura você, o Zombie invoca ajudantes, o Fortification protege."]
	quest.6760917F3037BAB3.title: "Cetros"
	quest.6781998E1070AD9C.quest_desc: ["Dissolution Chamber, Chemical Washer e Chemical Crystallizer juntos: 1 minério vira 5 lingotes."]
	quest.6781998E1070AD9C.title: "Minério x5"
	quest.67BBC2EBA8703DB9.quest_desc: ["As máquinas mostram os espaços de addon como hologramas em volta. Coloque addons ali para velocidade, eficiência e mais."]
	quest.67BBC2EBA8703DB9.title: "Addons de Máquina"
	quest.67E977285BCB8A7B.quest_desc: ["Transforma as Predictions em qualquer drop daquele mob, sem matar nada."]
	quest.67E977285BCB8A7B.title: "Loot Fabricator"
	quest.682398BF0EC65776.quest_desc: ["As abelhas também polinizam árvores: o Productive Trees adiciona centenas de árvores frutíferas e madeiras novas."]
	quest.682398BF0EC65776.title: "Productive Trees"
	quest.68293EEBE58BA076.quest_desc: ["Slice \\& Dice: um aspersor do Create que rega plantações, e um Slicer que corta comida sozinho."]
	quest.68293EEBE58BA076.title: "Aspersor"
	quest.6831EA6498388BC3.quest_desc: ["Prensa placas, hastes e engrenagens com moldes."]
	quest.6831EA6498388BC3.title: "Prensa de Metal"
	quest.6845C6B7D2274FFD.quest_desc: ["Classifica os materiais de E a MAX. Notas melhores dão atributos melhores."]
	quest.6845C6B7D2274FFD.title: "Classificador de Materiais"
	quest.684E0216886F357D.quest_desc: ["A Fuel Refinery transforma petróleo em combustível de foguete. Procure petróleo no subsolo e nos oceanos."]
	quest.684E0216886F357D.title: "Combustível de Foguete"
	quest.68759676CD982F61.quest_desc: ["Uma roda gigante que minera veios minerais achados com a Core Sample Drill. Minérios infinitos!"]
	quest.68759676CD982F61.title: "Escavadeira"
	quest.68B6AE762D3BF772.quest_desc: ["Soque uma árvore, transforme as toras em tábuas e faça uma bancada."]
	quest.68B6AE762D3BF772.title: "Bancada de Trabalho"
	quest.68ECD1B302C5BF3E.quest_desc: ["Sintonize num minério e ela mostra onde está o mais próximo."]
	quest.68ECD1B302C5BF3E.title: "Divination Rod"
	quest.68FD987A3B6B40AC.quest_desc: ["Aparelhos mais rápidos e packs inteiros de uma vez."]
	quest.68FD987A3B6B40AC.title: "Melhorias"
	quest.6904959C430BBEED.quest_desc: ["O MFFS transforma energia em Fortron, o combustível dos campos de força."]
	quest.6904959C430BBEED.title: "Coercion Deriver"
	quest.6904C75D4F45B265.quest_desc: ["Guarda energia. Melhore depois na bancada."]
	quest.6904C75D4F45B265.title: "Cubo de Energia"
	quest.6910BBAD04F26584.quest_desc: ["O Ostrum vem de Marte. Ele é usado no Foguete Nível 3."]
	quest.6910BBAD04F26584.title: "Ostrum"
	quest.69315D11765C9EB9.quest_desc: ["Um canhão de tiro rápido alimentado com cartuchos."]
	quest.69315D11765C9EB9.title: "Autocanhão"
	quest.6936B0EC241F71E6.quest_desc: ["Deixa um item inquebrável na forja."]
	quest.6936B0EC241F71E6.title: "Eternal Stella"
	quest.694395503CA95A00.quest_desc: ["Crie variáveis e operadores para automatizar qualquer coisa com lógica."]
	quest.694395503CA95A00.title: "Logic Programmer"
	quest.694D16340FE590F4.quest_desc: ["As máquinas do Oritech crescem com addons colocados em volta delas. O Pulverizer dobra os minérios."]
	quest.694D16340FE590F4.title: "Oritech"
	quest.696F6B86C5B96863.quest_desc: ["Plante na terra arada: elas produzem mais Essência de Inferium."]
	quest.696F6B86C5B96863.title: "Sementes de Inferium"
	quest.69C2B2AE0EB583EE.quest_desc: ["Colocam e tiram energia do Energy Core. Coloque vidro em cima ou embaixo para escolher a direção."]
	quest.69C2B2AE0EB583EE.title: "Energy Pylons"
	quest.69D88CBADD8057EE.quest_desc: ["Puxe itens para dentro, mande para fora, e use qualquer baú como External Storage."]
	quest.69D88CBADD8057EE.title: "Importador e Exportador"
	quest.69E17286234415EA.quest_desc: ["Coloque conectores e clique neles com um rolo de fio para ligar. O LV Accumulator guarda energia."]
	quest.69E17286234415EA.title: "Fios e Baterias"
	quest.69E66DBD36A31A43.quest_desc: ["Com cloreto de hidrogênio, a Chemical Injection Chamber transforma 1 minério em 4 shards."]
	quest.69E66DBD36A31A43.title: "Minério x4"
	quest.69E9AD6E501EC684.quest_desc: ["Um Propeller Bearing com uma hélice empurra o seu veículo para frente. Alimente com rotação."]
	quest.69E9AD6E501EC684.title: "Hélices"
	quest.69FC31F4837C2C75.quest_desc: ["Segure G em cima de qualquer item do AE2 para abrir a página do guia. Tudo está explicado lá."]
	quest.69FC31F4837C2C75.title: "Guia do AE2"
	quest.6A3D1EFD28C2B4AD.quest_desc: [
		"Montada na Gun Bench do Scorched Guns, com o Scorched Blueprint, peças pesadas, um Frasco Radioativo, Polônio e um Bloco de Urânio."
		""
		"Ela atira Balas Radioativas."
	]
	quest.6A3D1EFD28C2B4AD.quest_subtitle: "200 balas de pura radiação"
	quest.6A3D1EFD28C2B4AD.title: "Minigun Radioativa"
