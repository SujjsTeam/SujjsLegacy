	quest.222A212F696C6BCC.title: "Minigun e Torreta"
	quest.224AF4B108107842.quest_desc: ["O composto num bloco de Organic Compost vira Solo Rico, que faz as plantações crescerem mais rápido."]
	quest.224AF4B108107842.title: "Solo Rico"
	quest.2270E907FFBA1DBC.quest_desc: ["Canos simples para itens, fluidos e energia. Clique na ponta do cano com uma Wrench para extrair."]
	quest.2270E907FFBA1DBC.title: "Pipez"
	quest.229A40906A1344CB.quest_desc: ["O guia do próprio mod. Todo glifo, ritual e máquina está explicado dentro."]
	quest.229A40906A1344CB.title: "Worn Notebook"
	quest.22C907FB180117FA.quest_desc: ["Coleta os itens caídos numa área e coloca no baú em que está preso."]
