	quest.772D1FCCD90E06B8.quest_desc: ["Cada estrutura de chefão tem o seu olho, feito como um Olho do Ender. Jogue para achar a estrutura."]
	quest.772D1FCCD90E06B8.title: "Olhos dos Chefões"
	quest.77AD644B6D06E28A.quest_desc: ["Na bigorna: o Scrap Tome tira um encantamento do item, o Extraction Tome tira todos sem destruir."]
	quest.77AD644B6D06E28A.title: "Tomos"
	quest.77C41AE5821B2BA6.quest_desc: ["Acesse a rede de longe."]
	quest.77C41AE5821B2BA6.title: "Grid Sem Fio"
	quest.77ECDC139AB5BAE8.quest_desc: ["Bata nos materiais em cima dela com um martelo para mudar o formato."]
	quest.77ECDC139AB5BAE8.title: "Stone Anvil"
	quest.78308B783D2A49BF.quest_desc: ["Uma torre de 4 x 4 com até 18 de altura. A água vira salmoura, e a salmoura vira lítio. Sol e calor aceleram."]
	quest.78308B783D2A49BF.title: "Torre de Evaporação"
	quest.7831722A78AAAE3E.quest_desc: ["Levam energia. Níveis maiores levam mais."]
	quest.7831722A78AAAE3E.title: "Cabos de Energia"
	quest.7852BDDCF4179361.quest_desc: ["Guarda Fortron e manda sem fio para máquinas na mesma frequência (definida com um Frequency Card)."]
	quest.7852BDDCF4179361.title: "Fortron Capacitor"
	quest.7875F87E7C0CF751.quest_desc: ["Carrega comida e alimenta você a partir dela."]
	quest.7875F87E7C0CF751.title: "Lancheira"
	quest.7899929221855C55.quest_desc: ["Um espírito dentro dela minera minérios de outra dimensão, para sempre."]
	quest.7899929221855C55.title: "Mina Dimensional"
	quest.7965F9FEE0201C21.quest_desc: ["O quinto nível. O equipamento de Supremium é muito forte."]
	quest.7965F9FEE0201C21.title: "Supremium"
	quest.7972719F669D79D6.quest_desc: ["O terceiro nível."]
	quest.7972719F669D79D6.title: "Tertium"
	quest.79A7BC1989571AD7.quest_desc: ["Leve um baú inteiro nas costas. Clique com o botão direito para abrir, ou aperte B."]
	quest.79A7BC1989571AD7.title: "Mochila"
	quest.79D4CE822DB17BE4.quest_desc: ["Controlador + Disk Drive com discos + Grid: todos os itens numa tela. Ligue com cabos."]
	quest.79D4CE822DB17BE4.title: "Rede de Armazenamento"
	quest.79D4CF802BEB35B4.quest_desc: ["Um Matter Transmitter manda você para um Matter Receiver, configurado com o Dialing Device."]
	quest.79D4CF802BEB35B4.title: "Teleportadores"
	quest.79DD0E0D63D790DB.quest_desc: [
		"{image:kubejs:textures/quests/dimensao_radioativa.png width:256 height:144 align:center}"
		""
		"Use o Controlador Dimensional para entrar na Dimensão Radioativa."
		""
		"&cCuidado:&r a radiação machuca. Leve proteção e cura."
	]
	quest.79DD0E0D63D790DB.title: "Rumo à Radiação"
	quest.7A6245600D4F9F8F.quest_desc: ["A Mercy Cross dá dano extra em mortos-vivos. A Magicbane fica mais forte com encantamentos."]
	quest.7A6245600D4F9F8F.title: "Armas Sagradas"
	quest.7AE86511A9E01FE1.quest_desc: ["Negocia sozinho: entram itens, saem esmeraldas ou produtos."]
	quest.7AE86511A9E01FE1.title: "Comércio Automático"
	quest.7B20DCBF78961261.quest_desc: ["Um metal raro para eletrônicos avançados."]
	quest.7B20DCBF78961261.title: "Platina"
	quest.7B2A773FA07B890C.quest_desc: ["Mekanism More Machines: prensa, torno e laminador para placas, hastes e fios, além de fábricas para quase toda máquina."]
	quest.7B2A773FA07B890C.title: "Mais Máquinas"
	quest.7B464445DBB13CBC.quest_desc: ["Um ímã de itens e XP."]
	quest.7B464445DBB13CBC.title: "Moeda da Fortuna"
	quest.7B790EFCE2B72F8D.quest_desc: ["O reator também bebe Source do Ars Nouveau: 3.600.000 por receita, por uma entrada de Source na parede da torre."]
	quest.7B790EFCE2B72F8D.title: "Source Absoluto"
	quest.7B960B19387EBFCE.quest_desc: [
		"O The Absolute precisa de mais quatro fluidos, em quantidades enormes:"
		""
		"- Time Fluid (Just Dire Things): 1.800.000 mB"
		"- Ether Gas (Industrial Foregoing): 900.000 mB"
		"- Tritium (Modern Industrialization): 450.000 mB"
		"- UU Matter (Modern Industrialization): 112.500 mB"
		""
		"Traga um balde de cada para provar que consegue fazer. Depois, construa as fábricas."
	]
	quest.7B960B19387EBFCE.title: "Fluidos Impossíveis"
	quest.7BC277AD58B604B7.quest_desc: ["A Thermopneumatic Processing Plant transforma LPG em plástico derretido; despeje e deixe esfriar."]
	quest.7BC277AD58B604B7.title: "Plástico"
	quest.7C79468A72A033D8.quest_desc: ["As Warp Plates teleportam quem fica em cima para a placa ligada. Os Return Scrolls levam você para a última waystone."]
	quest.7C79468A72A033D8.title: "Placas e Pergaminhos"
	quest.7C8B7E93FA90A242.quest_desc: ["Adicione Augments ao equipamento de essência na Tinkering Table: absorção, velocidade, força, voo."]
	quest.7C8B7E93FA90A242.title: "Equipamento Supremium"
	quest.7CAC4DF97FF8B270.quest_desc: ["Guarda XP líquida. O XP Tap devolve para você."]
	quest.7CAC4DF97FF8B270.title: "Tanque de XP"
	quest.7CB6B29B1A18B712.quest_desc: ["As máquinas ficam mais rápidas com capacitores melhores no espaço delas."]
	quest.7CB6B29B1A18B712.title: "Capacitores"
	quest.7CC5626BE88C6008.quest_desc: ["Moedas e lojas para servidores: o Vendor vende itens por moedas, o Bank Terminal guarda o seu dinheiro."]
	quest.7CC5626BE88C6008.title: "Numismatics"
	quest.7CCDA53AF3A997DC.quest_desc: ["Simply Light e Additional Lights adicionam lâmpadas de toda cor e formato."]
	quest.7CCDA53AF3A997DC.title: "Luzes"
	quest.7CE704A25FAA9874.quest_desc: ["O Aquaculture adiciona muitos peixes, varas melhores, anzóis e iscas. Pesque em biomas diferentes para pegar coisas diferentes."]
	quest.7CE704A25FAA9874.title: "Pesca Melhor"
	quest.7CEBC36E75A0EFDE.quest_desc: ["Feito por Montagem Sequencial: uma série de Deployers e Prensas em cima de uma esteira. Veja a receita no JEI para ver cada passo."]
	quest.7CEBC36E75A0EFDE.title: "Mecanismo de Precisão"
	quest.7D0F919907D1BAF5.quest_desc: ["O primeiro núcleo. É a base das máquinas dracônicas."]
	quest.7D0F919907D1BAF5.title: "Núcleo de Dracônio"
	quest.7DBCC2A0AEAEDAC3.quest_desc: ["Um propulsor elétrico: sem combustível, só energia."]
