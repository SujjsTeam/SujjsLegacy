	quest.6F87C33B4DB2F03F.quest_desc: ["A Powered funciona com energia. A Heated também derrete os favos em mel líquido."]
	quest.6F87C33B4DB2F03F.title: "Centrífugas Melhores"
	quest.70502A510BFE1370.quest_desc: ["Complete a moldura do Portal do End com os Olhos do Ender e pule dentro."]
	quest.70502A510BFE1370.title: "O End"
	quest.70D1810850B9AC55.quest_desc: ["Separa água em hidrogênio e oxigênio. O hidrogênio também alimenta o Gas-Burning Generator."]
	quest.70D1810850B9AC55.title: "Electrolytic Separator"
	quest.71A2A56EA9FAD1C2.quest_desc: ["Cada nível de espírito (Foliot, Djinni, Afrit, Marid) precisa do seu livro vinculado. Escreva o nome com Purified Ink."]
	quest.71A2A56EA9FAD1C2.title: "Livros de Vínculo"
	quest.71BB2B9E11F69948.quest_desc: ["Esmague matéria numa Singularidade e exploda com Ender Dust: duas singularidades ligadas. Elas ligam Quantum Bridges entre dimensões."]
	quest.71BB2B9E11F69948.title: "Singularidade Quântica"
	quest.71E5D5C9840E3642.quest_desc: ["Destrua os cristais no topo das torres de obsidiana e depois derrote o dragão."]
	quest.71E5D5C9840E3642.title: "&5Dragão do Ender"
	quest.71F3A1F307A0A79F.quest_desc: ["Define qualquer velocidade para a engrenagem grande acima dele."]
	quest.71F3A1F307A0A79F.title: "Controlador de Velocidade"
	quest.720ECD4ED85B8FA2.quest_desc: ["O melhor equipamento do mod, feito com Escamas de Dragão na forja."]
	quest.720ECD4ED85B8FA2.title: "Draco Arcanus"
	quest.724340D04C6A1AC6.quest_desc: ["Protege a área de dentro: mata ou bloqueia invasores. O Biometric Identifier diz quem é permitido."]
	quest.724340D04C6A1AC6.title: "Interdiction Matrix"
	quest.72B4D6BA4288CBB7.quest_desc: ["Guarda energia. Níveis melhores guardam muito mais."]
	quest.72B4D6BA4288CBB7.title: "Célula de Energia"
	quest.72FA60C1AD3575B9.quest_desc: ["Todo metal tem placas, engrenagens, hastes e pós. Faça com martelo, prensa ou as máquinas de cada mod."]
	quest.72FA60C1AD3575B9.title: "Placas e Engrenagens"
	quest.7305D23501116829.quest_desc: ["Matar Withers num Mob Crusher dá Ether Gas. O The Absolute precisa de 900.000 mB."]
	quest.7305D23501116829.title: "Ether Gas"
	quest.73B8E730ACC22C27.quest_desc: ["Queima os espinhos das Thornlands para abrir o caminho até o Final Plateau."]
	quest.73B8E730ACC22C27.title: "Lamp of Cinders"
	quest.73D08B23F8A56647.quest_desc: ["Gemas achadas no subsolo. Minere com Fortuna para conseguir mais."]
