	quest.7403874DE9181A53.quest_desc: ["O projeto das armas mais fortes, e da Minigun Radioativa."]
	quest.7403874DE9181A53.title: "Projeto Scorched"
	quest.742C50F55C3CC3D3.quest_desc: ["Cada nível de Fusion precisa de injetores daquele nível. O Controlador Dimensional precisa de 14 injetores Caóticos."]
