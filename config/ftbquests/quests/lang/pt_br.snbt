	quest.21AF27D68F78DE5E.quest_desc: [
		"A receita do The Absolute gasta 3.500.000 FE a cada tick, durante 10 minutos."
		""
		"Se a energia faltar num único tick, a receita para e recomeça. Um Draconic Reactor alimentando um Draconic Energy Core é o jeito mais seguro."
	]
	quest.21AF27D68F78DE5E.title: "3,5 Milhões de FE por Tick"
	quest.21C802F99746574C.quest_desc: ["As melhorias de produtividade, tempo e reprodução deixam as colmeias muito melhores."]
	quest.21C802F99746574C.title: "Melhorias de Colmeia"
	quest.21CDB88FA1606EE8.quest_desc: ["O livro guia do EvilCraft."]
	quest.21CDB88FA1606EE8.title: "Origins of Darkness"
	quest.21DD095FD73ADD0B.quest_desc: ["Copia, move, escava ou limpa áreas definidas por um Shape Card."]
	quest.21DD095FD73ADD0B.title: "Builder"
	quest.2202CED9BB1CE606.quest_desc: ["Um radar giratório que mostra mobs, jogadores e veículos num Monitor. Ele pode mirar os Big Cannons sozinho."]
	quest.2202CED9BB1CE606.title: "Create Radar"
	quest.2207B81C8DCCFE0C.quest_desc: ["Chefões com nome nascem no escuro com equipamento cheio de afixos. O Boss Summoner invoca um."]
