	quest.2C01C0B8921D326E.title: "Kits de Reparo"
	quest.2C05FA50FC16A999.quest_desc: ["É mesmo. Minere um pouco de Moon Cheese Ore."]
	quest.2C05FA50FC16A999.title: "A Lua é Feita de Queijo"
	quest.2C6EF93BA96B9D46.quest_desc: ["Carrega com energia os itens numa esteira ou depot embaixo dela."]
