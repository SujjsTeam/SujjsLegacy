	quest.6A6A42213AF679D3.title: "Minoshroom"
	quest.6A80116C2FB600B6.quest_desc: ["Mede a distância entre dois blocos."]
	quest.6A80116C2FB600B6.title: "Trena"
	quest.6A8C6FD953234D66.quest_desc: ["O terceiro nível."]
	quest.6A8C6FD953234D66.title: "Celestigem"
	quest.6AB4AE213B7F84C4.quest_desc: ["Simula o mob com energia e Prediction Matrices, dando Predictions."]
	quest.6AB4AE213B7F84C4.title: "Simulation Chamber"
	quest.6AC6C5C217F8684B.quest_desc: ["A Navigation Table e o Altitude Sensor ajudam a saber onde você está e a que altura voa."]
	quest.6AC6C5C217F8684B.title: "Navegação"
	quest.6AFD9E4DB339330F.quest_desc: ["A Levitita flutua. Alguns blocos dela deixam uma estrutura mais leve que o ar."]
	quest.6AFD9E4DB339330F.title: "Levitita"
	quest.6AFF6AAD929333AA.quest_desc: ["Dispara um laser que transforma o bloco ou itens na frente. Usado para fazer os Cristais."]
	quest.6AFF6AAD929333AA.title: "Atomic Reconstructor"
	quest.6B299C4617851FDF.quest_desc: ["Um projeto + materiais na bancada fazem uma peça. Uma cabeça + um cabo fazem a ferramenta."]
	quest.6B299C4617851FDF.title: "Projetos de Ferramenta"
	quest.6B55218228B3A3E3.quest_desc: [
		"Junte 46 Fragmentos do Absoluto."
		""
		"No Implosion Compressor do Modern Industrialization, com 4 TNTs Industriais, um Frasco Radioativo, um Draconic Core e um Bloco de Irídio, eles viram um novo The Absolute, sem o reator."
	]
	quest.6B55218228B3A3E3.title: "O Segundo Caminho"
	quest.6B5DF274D6A78EB1.quest_desc: ["Os processadores Logic, Calculation e Engineering são o coração de toda peça do AE2."]
	quest.6B5DF274D6A78EB1.title: "Processadores"
	quest.6B795168B7AE93A4.quest_desc: ["Robôs que você programa para minerar, construir e plantar. Dê uma picareta e combustível."]
	quest.6B795168B7AE93A4.title: "Turtles"
	quest.6B8DB50B030F9849.quest_desc: ["Salve programas em disquetes e leve entre computadores."]
	quest.6B8DB50B030F9849.title: "Discos"
	quest.6BB4A45CCB850CFA.quest_desc: ["Fluidos ligados por frequência. O tablet manda os itens coletados para o seu Baú Dimensional."]
	quest.6BB4A45CCB850CFA.title: "Tanque Dimensional"
	quest.6BE3B3F3AF7AA596.quest_desc: ["Um monstro do mar na Sunken City."]
	quest.6BE3B3F3AF7AA596.title: "The Leviathan"
	quest.6C112ABA40DC9FDB.quest_desc: ["Monstros nascem nela muito mais rápido, até na luz. A Delightful Dirt faz o mesmo com animais."]
	quest.6C112ABA40DC9FDB.title: "Dreadful Dirt"
	quest.6C1B1C75644ACD68.quest_desc: [
		"Cada favo da Abelha Absoluta tem 1% de chance de dar um Fragmento do Absoluto na centrífuga."
		""
		"Um fragmento a cada 10.000 voltas para a colmeia, em média. Construa grande."
	]
	quest.6C1B1C75644ACD68.title: "Fragmento do Absoluto"
	quest.6C5C01302190BC61.quest_desc: ["O combustível do reator. Minere Yellorite e derreta."]
	quest.6C5C01302190BC61.title: "Yellorium"
	quest.6C88D1C96851BE47.quest_desc: ["Proteja a sua base em servidores: fechaduras, câmeras, alarmes, minas e blocos reforçados. O manual lista tudo."]
	quest.6C88D1C96851BE47.title: "SecurityCraft"
	quest.6CE9942CEB9D5D0A.quest_desc: ["Guarda rotação e devolve depois."]
	quest.6CE9942CEB9D5D0A.title: "Bateria Cinética"
	quest.6D0EBFD3C70D5B01.quest_desc: ["Os canhões são fundidos com metal derretido em moldes."]
	quest.6D0EBFD3C70D5B01.title: "Ferro Fundido"
	quest.6D1E897278C1DF77.quest_desc: ["Guarda todo livro encantado como pontos. Retire qualquer nível para o qual tenha pontos."]
	quest.6D1E897278C1DF77.title: "Biblioteca de Encantamentos"
	quest.6D59B64518F48F0D.quest_desc: ["Esmeralda no Energizing Orb."]
	quest.6D59B64518F48F0D.title: "Cristal Espiritual"
	quest.6D910DF066A52E97.quest_desc: ["Motor, Piston, Conveyor, Robot Arm e Pump: toda máquina elétrica é feita com eles."]
	quest.6D910DF066A52E97.title: "Peças de Máquina"
	quest.6D9AC5D2992C9999.quest_desc: ["Um controlador gerencia uma rede inteira de cabos e conectores, com filtros e prioridades."]
	quest.6D9AC5D2992C9999.title: "XNet"
	quest.6DA2789C666248DE.quest_desc: ["Queima combustível para energia."]
	quest.6DA2789C666248DE.title: "Gerador Stirling"
	quest.6DA8A0EC2858723F.quest_desc: ["O material mais valioso do Mekanism. É usado na Bomba Atômica, na Munição Infinita e no The Absolute."]
	quest.6DA8A0EC2858723F.title: "&5Antimatéria"
	quest.6E00E385B4774F5F.quest_desc: ["Igual ao Ore Laser, mas para fluidos. Com um Nucleon por perto, ele coleta o fluido Nucleon para o The Absolute."]
	quest.6E00E385B4774F5F.title: "Fluid Laser Base"
	quest.6E1C7BE371C0E78D.quest_desc: ["Monte um dirigível ou avião, transforme com o Physics Assembler e voe com ele."]
	quest.6E1C7BE371C0E78D.title: "Primeiro Voo"
	quest.6E21526C1303DB49.quest_desc: ["Os Whirlisprigs cultivam plantas, as Wixies fabricam e fazem poções, os Drygmies coletam drops de mobs sem matar."]
	quest.6E21526C1303DB49.title: "Ajudantes Mágicos"
	quest.6E2557AE5298AC32.quest_desc: ["Uma broca que minera 3 x 3, movida a diesel. Melhore na bancada de engenheiro."]
	quest.6E2557AE5298AC32.title: "Broca de Mineração"
	quest.6E40A3DC2A667689.quest_desc: ["Acelere itens num anel e colida para fazer materiais exóticos."]
	quest.6E40A3DC2A667689.title: "Acelerador de Partículas"
	quest.6E52DA31D37A98BB.quest_desc: ["Derrete minérios e ligas com eletricidade, usando eletrodos de grafite."]
	quest.6E52DA31D37A98BB.title: "Forno a Arco"
	quest.6E64095B9DE4F516.quest_desc: ["Ouro transformado com Pó de Mundabitur e Pó de Cristal Arcano."]
	quest.6E64095B9DE4F516.title: "Deorum"
	quest.6E6EEB5FE5B1869C.quest_desc: ["8 pedregulhos fazem uma fornalha. Use para derreter minérios e cozinhar comida."]
	quest.6E6EEB5FE5B1869C.title: "Fornalha"
	quest.6EA3D18194BD51AA.quest_desc: ["A Water Pump dá água e a Caldeira queima combustível para transformar em vapor."]
	quest.6EA3D18194BD51AA.title: "Caldeira"
	quest.6F127A67A73D2E3C.quest_desc: ["Acelera as plantações acima dele."]
	quest.6F127A67A73D2E3C.title: "Acelerador de Crescimento"
	quest.6F276143970EBC71.quest_desc: ["Triture gemas no Mortar and Pestle. Os pós desenham círculos mágicos (Mahoujin)."]
	quest.6F276143970EBC71.title: "Pós"
	quest.6F3D614D696B2DD4.quest_desc: ["Pattern Provider + Molecular Assembler + CPU de Crafting: peça qualquer item e a rede fabrica."]
	quest.6F3D614D696B2DD4.title: "Fabricação Automática"
	quest.6F3E2CCC5BC9D8EC.quest_desc: ["Blocos que pegam a aparência de qualquer bloco com que você clicar neles, em vários formatos."]
	quest.6F3E2CCC5BC9D8EC.title: "Copycats"
	quest.6F4BD5EA520D46AE.quest_desc: ["Cada coluna de barras precisa de um Control Rod em cima. Os Access Ports colocam combustível e tiram resíduo. O Power Tap entrega a energia."]
	quest.6F4BD5EA520D46AE.title: "Peças do Reator"
	quest.6F7039E7221FF9F3.quest_desc: ["Esteiras de tanque sobem em qualquer lugar. Junte com o Create Big Cannons para um tanque de verdade."]
	quest.6F7039E7221FF9F3.title: "Esteiras"
	quest.6F747F09610A924B.quest_desc: ["QuarryPlus: coloque 3 marcadores em L para definir a área, a Quarry ao lado de um e dê energia. Ela cava até a bedrock."]
