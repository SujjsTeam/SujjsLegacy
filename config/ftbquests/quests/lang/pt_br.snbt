	quest.00323A853D58B347.quest_desc: ["Hostile Neural Networks: sintonize um Blank Data Model num mob (clique nele) e deixe no Deep Learner. Cada abate treina o modelo."]
	quest.00323A853D58B347.title: "Data Models"
	quest.00426F4EA8586D48.quest_desc: ["O Copy Paste Gadget salva uma construção e coloca de novo. O Destruction Gadget remove uma área inteira."]
	quest.00426F4EA8586D48.title: "Copiar e Destruir"
	quest.0050471516C00E36.quest_desc: ["Agache + clique para salvar onde você está; clique para teleportar de volta. O Advanced Dislocator salva vários lugares."]
	quest.0050471516C00E36.title: "Dislocator"
	quest.00A444DA6DAE8CF1.quest_desc: ["Coloque um ninho no bioma certo e use um Honey Treat nele para atrair uma abelha solitária selvagem."]
	quest.00A444DA6DAE8CF1.title: "Ninhos Solitários"
	quest.00E2FF4D0D064F35.quest_desc: ["Fabrica com 8 itens em volta e um fluido. A principal máquina de fabricação do mod."]
	quest.00E2FF4D0D064F35.title: "Dissolution Chamber"
	quest.01104A34E54D0168.quest_desc: ["O Oxygen Loader transforma água em oxigênio e enche o seu Traje Espacial."]
	quest.01104A34E54D0168.title: "Carregador de Oxigênio"
	quest.01A0084736DF571B.quest_desc: ["Um Mixer em cima de uma Basin mistura itens e fluidos. Algumas receitas precisam de calor de uma Blaze Burner embaixo da Basin."]
	quest.01A0084736DF571B.title: "Misturando"
	quest.01A1652A426F00C7.quest_desc: ["O centro dos rituais do mod. Coloque pedestais em volta e use Essências."]
	quest.01A1652A426F00C7.title: "Forja de Hefesto"
	quest.01B042B15FD80A43.quest_desc: ["Mob Grinding Utils: os ventiladores empurram os mobs. Melhore largura, altura e velocidade."]
	quest.01B042B15FD80A43.title: "Ventilador"
	quest.01D317DEA9EAD76F.quest_desc: ["Um veículo para explorar os planetas. Ele roda com combustível de foguete."]
	quest.01D317DEA9EAD76F.title: "Rover"
	quest.01DD9A3E6F942C32.quest_desc: ["Curto alcance, muito dano. Usam cartuchos de escopeta."]
	quest.01DD9A3E6F942C32.title: "Escopetas"
	quest.01F21A5853D8DD72.quest_desc: ["Um propulsor que você pode apontar. Ótimo para pairar e girar parado."]
	quest.01F21A5853D8DD72.title: "Propulsor Vetorial"
	quest.020EF19B51E49866.quest_desc: ["O equipamento mais forte do Draconic Evolution."]
	quest.020EF19B51E49866.title: "Equipamento Caótico"
	quest.022EC127C19E89AD.quest_desc: ["Explosivos escondidos. Desarme os seus com alicate."]
	quest.022EC127C19E89AD.title: "Minas"
	quest.02DC5F1FCFA13F83.quest_desc: ["Miras, canos e coronhas mudam a sua arma. Coloque pelo menu da arma."]
	quest.02DC5F1FCFA13F83.title: "Acessórios"
	quest.03B5836C0D49245B.quest_desc: ["O terceiro nível de circuito."]
	quest.03B5836C0D49245B.title: "Circuito Digital"
	quest.0402E976713DA2C3.quest_desc: ["Clique com o botão direito e escolha uma estrutura: a bússola aponta o caminho para a mais próxima."]
	quest.0402E976713DA2C3.title: "Bússola do Explorador"
	quest.043BB41633A6AEEC.quest_desc: ["O livro do próprio MI explica cada era: vapor, eletricidade, petróleo, nuclear e quântica."]
	quest.043BB41633A6AEEC.title: "Guia"
	quest.043E06F9CE5DF980.quest_desc: ["Monta Withers sozinho. Com um Mob Crusher embaixo, é a fazenda de Ether Gas para o The Absolute."]
	quest.043E06F9CE5DF980.title: "Wither Builder"
	quest.046128AFA686F0C9.quest_desc: ["O Fluido do Tempo é usado na Time Wand e no The Absolute (1.800.000 mB)."]
	quest.046128AFA686F0C9.title: "Fluido do Tempo"
	quest.0475C8A95CD2F33E.quest_desc: ["Ele chega a Vênus e Mercúrio."]
	quest.0475C8A95CD2F33E.title: "Foguete Nível 3"
	quest.0504E7C7AD59C026.quest_desc: ["Processadores Basic (ferro), Improved (ouro) e Advanced (diamante)."]
	quest.0504E7C7AD59C026.title: "Processadores"
	quest.052C84D42730B5E4.quest_desc: ["Faz abelhas bebês crescerem e choca ovos."]
	quest.052C84D42730B5E4.title: "Incubadora"
	quest.0540DCECE3AA2043.quest_desc: ["Minera uma área inteira com um laser, ou carrega itens de longe."]
	quest.0540DCECE3AA2043.title: "Laser Arm"
	quest.0543A947F7768C2D.quest_desc: ["Monte uma moldura de tijolos de pedra como um portal do Nether e acenda com o Catalyst para entrar neste mundo subterrâneo escuro."]
	quest.0543A947F7768C2D.title: "O Undergarden"
	quest.061007D01EF92DA5.quest_desc: ["O Experience Obelisk guarda a sua XP. O XP Vacuum coleta os orbes."]
	quest.061007D01EF92DA5.title: "Experiência"
	quest.061D0BFFF106485C.quest_desc: ["Ferro transformado pelo Goo. O primeiro material do mod."]
	quest.061D0BFFF106485C.title: "Ferricore"
	quest.0622500AECFDBAF9.quest_desc: ["Ache uma Cidade do End pelo portal de saída e pegue o Élitro no Navio do End."]
	quest.0622500AECFDBAF9.title: "Élitro"
	quest.0638CE4C59ECB464.quest_desc: [
		"A parte final do Sujjs Legacy começa aqui: uma dimensão radioativa, usinas nucleares, soldados irradiados e o Nucleon."
		""
		"Tudo nesta parte é fim de jogo. Garanta que o seu Mekanism, Draconic Evolution, AE2 e Modern Industrialization estejam bem avançados."
	]
	quest.0638CE4C59ECB464.quest_subtitle: "O mod do próprio Sujjs Team"
	quest.0638CE4C59ECB464.title: "&aSujjs's Tweaks"
	quest.064CD016477806F7.quest_desc: ["Reatores maiores que podem ter refrigeração ativa para fazer vapor."]
	quest.064CD016477806F7.title: "Reator Reforçado"
	quest.0705F545292AFB9B.quest_desc: ["O Fluix é usado nos cabos e na maioria das peças."]
	quest.0705F545292AFB9B.title: "Fluix"
	quest.0744B1A2531EDCB1.quest_desc: ["Jogue uma Pérola do Ender numa colmeia ou ninho de abelhas para ser puxado para a dimensão da colmeia gigante."]
	quest.0744B1A2531EDCB1.title: "A Bumblezone"
	quest.07A268D2768FA85A.quest_desc: ["Source é energia mágica. Os Sourcelinks produzem (o Volcanic queima combustível) e os Source Jars guardam."]
	quest.07A268D2768FA85A.title: "Source"
	quest.07B17B4D0FB4BC24.quest_desc: [
		"Construa o Reator Absoluto: um anel acelerador de 30 x 30 com uma torre de 10 camadas."
		""
		"{image:kubejs:textures/quests/reator_montado.png width:256 height:144 align:center}"
		""
		"Camada por camada, vista de cima:"
		"{image:kubejs:textures/quests/reator_guia.png width:300 height:175 align:center}"
		""
		"O controlador fica no meio da face norte da torre, na camada 2, virado para fora, na direção do anel. As entradas e saídas vão nas paredes da torre."
		""
		"Quando a estrutura estiver completa, todas as peças do Modular Machinery ficam verdes."
	]
	quest.07B17B4D0FB4BC24.quest_subtitle: "A máquina final"
	quest.07B17B4D0FB4BC24.title: "&5O Reator Absoluto"
	quest.07B1B05DE7580842.quest_desc: ["Um metal comum, usado no bronze e nas primeiras máquinas."]
	quest.07B1B05DE7580842.title: "Estanho"
	quest.07EA63794CE30048.quest_desc: ["O cristal mais alto do Powah: Estrela do Nether, Blocos de Redstone e Cristais Flamejantes. Ele é usado no The Absolute."]
	quest.07EA63794CE30048.title: "&cCristal Nitro"
	quest.080A4761EC03CB3A.quest_desc: ["Torretas de arma e de Chemthrower defendem a sua base. Escolha em quem elas atiram."]
	quest.080A4761EC03CB3A.title: "Torretas"
	quest.085FA4F6AB212713.quest_desc: [
		"64 Munições Universais e 1.000 mB de antimatéria no Antiprotonic Nucleosynthesizer do Mekanism."
		""
		"Deixe no inventário e as suas armas nunca ficam sem munição."
	]
	quest.085FA4F6AB212713.quest_subtitle: "Nunca mais recarregue"
	quest.085FA4F6AB212713.title: "Munição Infinita"
	quest.087073041FC23BDF.quest_desc: ["Use um Tree Fluid Extractor numa tora para coletar látex e depois uma Latex Processing Unit para fazer borracha e plástico."]
	quest.087073041FC23BDF.title: "Látex e Borracha"
	quest.08B95D749A91FE11.quest_desc: ["As armas são montadas na Bancada de Armas, peça por peça, com um projeto."]
	quest.08B95D749A91FE11.title: "Bancada de Armas"
	quest.08E2A3F56540A638.quest_desc: ["Sementes que produzem ferro, cobre, diamantes e quase tudo. Veja as receitas no JEI."]
	quest.08E2A3F56540A638.title: "Sementes de Recursos"
	quest.0926DCCC2394955C.quest_desc: ["Com refrigeração a sódio, o reator esquenta o sódio e a Caldeira transforma em vapor para a turbina."]
	quest.0926DCCC2394955C.title: "Caldeira Termoelétrica"
	quest.0930D32C225BD4DE.quest_desc: ["Transforma o resíduo Cyanite em Blutonium."]
	quest.0930D32C225BD4DE.title: "Reprocessador"
	quest.0936F8B47C88270A.quest_desc: ["Guano e salitre fazem pólvora. O Nitro Powder, para munição avançada, vem dos blocos de química do Scorched Guns."]
	quest.0936F8B47C88270A.title: "Cadeia da Pólvora"
	quest.0956AEC1B723D9B1.quest_desc: ["Redstone sem fio: dois links com os mesmos dois itens de frequência conversam entre si."]
	quest.0956AEC1B723D9B1.title: "Redstone Link"
	quest.095AC88BF59AA602.quest_desc: ["O metal mais raro do modpack, achado no fundo e no End. É usado nas máquinas de fim de jogo e no Reator Absoluto."]
	quest.095AC88BF59AA602.title: "Irídio"
	quest.0961848B9B1B7301.quest_desc: ["O Plant Sower planta e o Plant Gatherer colhe numa área quadrada na frente deles."]
	quest.0961848B9B1B7301.title: "Fazenda Automática"
	quest.09BB692E2E43BE31.quest_desc: ["O Fiery Blood da Hidra + ferro fazem Fiery Ingots, para ferramentas que queimam e derretem."]
	quest.09BB692E2E43BE31.title: "Equipamento Flamejante"
	quest.09CF696E58DD582A.quest_desc: ["Uma torreta que atira em invasores. Configure para atacar jogadores, mobs ou os dois."]
	quest.09CF696E58DD582A.title: "Sentinela"
	quest.0A12638833A2EFDD.quest_desc: ["Um computador programável de verdade dentro do jogo, usando a linguagem Lua. Digite 'help' para começar e 'edit nome' para escrever um programa."]
	quest.0A12638833A2EFDD.title: "Computador"
	quest.0A560048A421E1C8.quest_desc: ["Pouse em Glacio, o planeta congelado de outra estrela."]
	quest.0A560048A421E1C8.title: "Glacio"
	quest.0A5ADB992DA9C380.quest_desc: ["Queima Fissile Fuel e esquenta o refrigerante. &cPerigo:&r se esquentar demais ele explode e espalha radiação. Mantenha sempre o refrigerante circulando."]
	quest.0A5ADB992DA9C380.title: "Reator de Fissão"
	quest.0A87F5A3B1EF2DE4.quest_desc: ["O contrário do motor: transforma rotação em energia FE para os outros mods."]
	quest.0A87F5A3B1EF2DE4.title: "Alternador"
	quest.0AA558B88013CAE4.quest_desc: ["Mande itens, fluidos, energia ou canais por um cabo só."]
	quest.0AA558B88013CAE4.title: "Túneis P2P"
	quest.0AB79B040C380C39.quest_desc: ["O fim de jogo de energia do MI, com plasma."]
	quest.0AB79B040C380C39.title: "Reator de Fusão"
	quest.0AD8A471D63A2484.quest_desc: ["A Enrichment Chamber transforma 1 minério em 2 pós."]
	quest.0AD8A471D63A2484.title: "Minério x2"
	quest.0ADD66E510E84A4D.quest_desc: ["Em cima de um Depot, a prensa achata lingotes em chapas. Em cima de uma Basin, ela compacta itens."]
	quest.0ADD66E510E84A4D.title: "Prensa Mecânica"
	quest.0B20577E53215770.quest_desc: ["A Calorita vem de Vênus. Ela é usada no foguete mais forte."]
	quest.0B20577E53215770.title: "Calorita"
	quest.0B36E0BF246ECCBF.quest_desc: ["Armadura movida a ar, com melhorias como botas a jato e rastreador de entidades."]
	quest.0B36E0BF246ECCBF.title: "Armadura Pneumática"
	quest.0B7CF1726E9CEBA6.quest_desc: ["Um chefão máquina na fábrica do Wither."]
	quest.0B7CF1726E9CEBA6.title: "The Harbinger"
	quest.0B7D41E2DD138BDD.quest_desc: ["Baús e barris que podem ser melhorados no lugar, sem esvaziar."]
	quest.0B7D41E2DD138BDD.title: "Baús Sofisticados"
	quest.0B8FDDD02A8DD2DB.quest_desc: ["Um baú que só abre com o código."]
	quest.0B8FDDD02A8DD2DB.title: "Baú com Senha"
	quest.0BD66A821CAF1F2F.quest_desc: ["Crafts \\& Additions: o Motor Elétrico transforma energia FE em rotação."]
	quest.0BD66A821CAF1F2F.title: "Motor Elétrico"
	quest.0C04F32D1B87C254.quest_desc: ["Os Laser Nodes movem itens, fluidos e energia sem fio. Ligue com a Laser Wrench e coloque cartões em cada lado."]
	quest.0C04F32D1B87C254.title: "Laser IO"
	quest.0C0ABC22ECA19244.quest_desc: ["O sistema de armazenamento do Occultism, controlado por espíritos."]
	quest.0C0ABC22ECA19244.title: "Armazenamento Mágico"
	quest.0C22372D6F4A82DA.quest_desc: ["Hellshelves, Seashelves e muitas outras. Cada uma muda os atributos da mesa de um jeito."]
	quest.0C22372D6F4A82DA.title: "Estantes Especiais"
	quest.0C363DA8FF913182.quest_desc: ["Carregado com redstone, ele duplica itens na bancada."]
	quest.0C363DA8FF913182.title: "Alkahestry Tome"
	quest.0C4E30EB0693329A.quest_desc: ["A Midas Touchstone conserta equipamento de ouro com glowstone. O Destruction Catalyst abre um túnel com pólvora."]
	quest.0C4E30EB0693329A.title: "Midas e Destruição"
	quest.0CC24E479348B22B.quest_desc: ["As Blazes vivem nas Fortalezas do Nether. As varas delas fazem Pó de Blaze e Olhos do Ender."]
	quest.0CC24E479348B22B.title: "Varas de Blaze"
	quest.0CCD50D3EEC3F010.quest_desc: ["As abelhas produzem favos nela. Os favos vão na Centrífuga para dar recursos."]
	quest.0CCD50D3EEC3F010.title: "Colmeia Avançada"
	quest.0D5DBEF559A76CA1.quest_desc: ["Cada célula guarda uma quantidade de tipos de item. Células maiores guardam mais."]
	quest.0D5DBEF559A76CA1.title: "Células de Armazenamento"
	quest.0D6925A22309E6B5.quest_desc: ["O Angelheart Vial salva você da morte uma vez. A Phoenix Down salva sempre, gastando Angelic Feathers."]
	quest.0D6925A22309E6B5.title: "Segundas Chances"
	quest.0D824B47A905FF03.quest_desc: ["Mostra as estruturas de chefões da Floresta do Crepúsculo como ícones."]
	quest.0D824B47A905FF03.title: "Mapa Mágico"
	quest.0D954CA1839BDD86.quest_desc: ["Usa Source para transformar gemas em Source Gems e essências."]
	quest.0D954CA1839BDD86.title: "Imbuement Chamber"
	quest.0DF29EA93BEED4CA.quest_desc: ["Uma gaveta guarda muitos packs de um item só. Botão direito guarda, botão esquerdo tira."]
	quest.0DF29EA93BEED4CA.title: "Gavetas"
	quest.0DF60946306ACF6D.quest_desc: ["O EvilCraft gira em torno de sangue. As Dark Gems ficam no subsolo."]
	quest.0DF60946306ACF6D.title: "Dark Gems"
	quest.0DF99E66CA86582F.quest_desc: ["Minere obsidiana com uma picareta de diamante, monte uma moldura de 4 x 5 e acenda com isqueiro."]
	quest.0DF99E66CA86582F.title: "Rumo ao Nether"
	quest.0E3DD50439F9146F.quest_desc: ["Baús ligados por frequência, públicos ou privados, entre dimensões."]
	quest.0E3DD50439F9146F.title: "Baú Dimensional"
	quest.0E9605910C70FF76.quest_desc: ["Grave um feitiço nelas na Mesa do Escriba: ele é lançado quando você acerta ou atira."]
	quest.0E9605910C70FF76.title: "Armas de Feitiço"
	quest.0EC340D1B59E24CF.quest_desc: ["Estabilizadores apontando para o Storage Actuator dão mais espaços. O Storage Remote abre de qualquer lugar."]
	quest.0EC340D1B59E24CF.title: "Mais Armazenamento"
	quest.0EE15390D6254E80.quest_desc: ["Mata mobs numa área de 7 x 7 na frente dele usando energia."]
	quest.0EE15390D6254E80.title: "Mob Grinder"
	quest.0EF465D618223790.quest_desc: ["O Apotheosis muda a mesa de encantamento: as estantes dão Eterna, Quanta e Arcana, mostrados na mesa. Estantes melhores dão encantamentos melhores."]
	quest.0EF465D618223790.title: "Encantamento Melhor"
	quest.0F0FCABB1D160A13.quest_desc: ["Borracha seca derretida em plástico."]
	quest.0F0FCABB1D160A13.title: "Plástico"
	quest.0F383DA4C4BAC51E.quest_desc: ["O segundo nível de núcleos e equipamentos."]
	quest.0F383DA4C4BAC51E.title: "Núcleo Wyvern"
	quest.0F45F282C922FE42.quest_desc: ["Defina um código. Digitar dá um sinal de redstone, para abrir uma porta reforçada."]
	quest.0F45F282C922FE42.title: "Teclado"
	quest.0F4BDDF5FE9ACFFA.quest_desc: ["Faz Quantum Infused Dust e Quantum Alloy com muita energia."]
	quest.0F4BDDF5FE9ACFFA.title: "Reaction Chamber"
	quest.0F7242E83EDFCD46.quest_desc: ["Um aldeão fazendeiro dentro planta e colhe para você."]
	quest.0F7242E83EDFCD46.title: "Fazendeiro"
	quest.0FB3C95D251B49C6.quest_desc: ["Corta toras em tábuas e blocos em lajes. De frente para uma árvore, derruba a árvore inteira."]
	quest.0FB3C95D251B49C6.title: "Serra Mecânica"
	quest.0FE0108866D5460E.quest_desc: ["A base das máquinas do RFTools."]
	quest.0FE0108866D5460E.title: "Moldura de Máquina"
	quest.10020F046B30E4B5.quest_desc: ["O Ender IO começa pelo Alloy Smelter: Electrical Steel, Energetic Alloy, Vibrant Alloy e mais."]
	quest.10020F046B30E4B5.title: "Alloy Smelter"
	quest.10467721C777096D.quest_desc: ["Versões de ouro com cores e suporte a mouse."]
	quest.10467721C777096D.title: "Avançados"
	quest.105E782A88391757.quest_desc: ["A Fundição faz ligas e a Centrífuga separa materiais."]
	quest.105E782A88391757.title: "Fundição e Centrífuga"
	quest.106F21EAFEA9744F.quest_desc: ["Os diamantes ficam bem fundo, abaixo da camada 0. Use uma picareta de ferro para minerar."]
	quest.106F21EAFEA9744F.title: "Diamantes!"
	quest.10BA7B37A68F131C.quest_desc: ["Remove chunks inteiros de uma vez. O Pump Module também drena fluidos."]
	quest.10BA7B37A68F131C.title: "Chunk Destroyer"
	quest.10BF2DBC1B3E0587.quest_desc: ["O Import Bus puxa itens para a rede, o Export Bus manda para fora, e o Storage Bus faz um baú virar parte da rede."]
	quest.10BF2DBC1B3E0587.title: "Barramentos"
	quest.1145E21CF1CC6803.quest_desc: ["O Manometer mostra a pressão e a temperatura de tudo em que você clicar."]
	quest.1145E21CF1CC6803.title: "Medindo a Pressão"
	quest.122217D277A3A056.quest_desc: ["O Create Propulsion adiciona propulsores que queimam combustível e asas que dão sustentação em velocidade."]
	quest.122217D277A3A056.title: "Propulsão"
	quest.1228FA5A346AF83D.quest_desc: ["Compacte 9 The Absolute numa Basin do Create com uma Mechanical Press, em cima de uma Blaze Burner superaquecida (alimentada com Blaze Cake)."]
	quest.1228FA5A346AF83D.title: "Bloco Absoluto"
	quest.1296DD671A1A32E8.quest_desc: ["9 Lingotes de Insanium. Dois destes vão no The Absolute."]
	quest.1296DD671A1A32E8.title: "Bloco de Insanium"
	quest.12A9029BD5D017C6.quest_desc: ["O mundo tem centenas de biomas novos. Use a Bússola da Natureza para achar o que você quer."]
	quest.12A9029BD5D017C6.title: "Biomas Novos"
	quest.1303F35C26271B1A.quest_desc: ["Quantum Computer, Reaction Chamber e o Quantum Processor, usado no The Absolute."]
	quest.1303F35C26271B1A.title: "&5Advanced AE"
	quest.13193A95413C4480.quest_desc: ["Do Ender Guardian. Bloqueia ataques e puxa os inimigos."]
	quest.13193A95413C4480.title: "Gauntlet of Guard"
	quest.1329FB467F867E2C.quest_desc: ["Mahou Tsukai: magia do mundo dos animes. Você aprende magias por contratos, e a mana cresce conforme você usa."]
	quest.1329FB467F867E2C.title: "Mahou Tsukai"
	quest.134DF8ACA2446769.quest_desc: ["O Agronomic faz Source com plantações crescendo, o Mycelial com comida, o Vitalic com mobs morrendo e se reproduzindo por perto."]
	quest.134DF8ACA2446769.title: "Mais Sourcelinks"
	quest.137DE7BB1E5E3977.quest_desc: [
		"O Immersive Engineering monta máquinas grandes de vários blocos: coloque os blocos no formato certo e bata no centro com o martelo."
		"O Engineer's Manual mostra cada estrutura."
	]
	quest.137DE7BB1E5E3977.title: "Martelo de Engenheiro"
	quest.13B9AE5880BFA0EB.quest_desc: ["Células de armazenamento de até 256M bytes."]
	quest.13B9AE5880BFA0EB.title: "MEGA Cells"
	quest.13BB57FA98DAAE67.quest_desc: ["Mais máquinas e ferramentas do MI, de motosserras a vapor até armaduras Nano e Quantum."]
	quest.13BB57FA98DAAE67.title: "Extended Industrialization"
	quest.13C07AAD5A115F77.quest_desc: ["Mantém chunks carregados. Também é ingrediente do Controlador Dimensional."]
	quest.13C07AAD5A115F77.title: "Estabilizador Dimensional"
	quest.13C1B386D821E5E6.quest_desc: ["Queima hidrogênio ou eteno. O eteno da Pressurized Reaction Chamber dá muita energia."]
	quest.13C1B386D821E5E6.title: "Gerador a Gás"
	quest.13DA1F9CECA4863A.quest_desc: ["Toda máquina e estrutura é explicada aqui, com uma visão 3D de cada uma."]
	quest.13DA1F9CECA4863A.title: "Manual do Engenheiro"
	quest.141A81DC794BBF33.quest_desc: ["Captura um mob e solta em outro lugar."]
	quest.141A81DC794BBF33.title: "Quantum Catcher"
	quest.1441A4ECD54D7AF3.quest_desc: ["Crescem em cima de um Nether Star Crux. Chega de lutar com o Wither."]
	quest.1441A4ECD54D7AF3.title: "Sementes de Estrela do Nether"
	quest.148607339618480B.quest_desc: ["Usado no Invar e no Constantan, e em muitas molduras de máquinas."]
	quest.148607339618480B.title: "Níquel"
	quest.14FCB36BAD588AA5.quest_desc: ["A Mob Slaughter Factory mata mobs e dá Meat líquida e Pink Slime."]
	quest.14FCB36BAD588AA5.title: "Pink Slime"
	quest.152343866ECEB36E.quest_desc: ["Tomates, repolho, cebola e arroz. Ache selvagens ou em baús de vilas. O arroz cresce na água."]
	quest.152343866ECEB36E.title: "Novas Plantações"
	quest.15E70DA0837014D6.quest_desc: ["Coloque uma tábua de ritual no Ritual Brazier e ative: voo, anoitecer, mudar o clima, teletransporte e mais."]
	quest.15E70DA0837014D6.title: "Rituais"
	quest.15F02DB9CB176DA5.quest_desc: ["Em cima de uma Colmeia Avançada: mais abelhas e espaços de melhoria."]
	quest.15F02DB9CB176DA5.title: "Caixa de Expansão"
	quest.16183BCF2E3899C9.quest_desc: ["Coloque melhorias na ponta do cano para mover mais, mais rápido, e para filtrar o que passa."]
	quest.16183BCF2E3899C9.title: "Melhorias de Cano"
	quest.162D7A727AEDCBEB.quest_desc: ["Os espíritos mais altos. As essências deles fazem as melhores ferramentas e o minerador de minérios raros."]
	quest.162D7A727AEDCBEB.title: "Afrit e Marid"
	quest.167B69F7D099B90F.quest_desc: ["Pesque baús Neptune's Bounty para achar Netúnio, para o melhor equipamento de pesca e armadura aquática."]
	quest.167B69F7D099B90F.title: "Netúnio"
	quest.169D0F28F628B618.quest_desc: ["Ósmio infundido com redstone. Toda máquina do Mekanism precisa de circuitos."]
	quest.169D0F28F628B618.title: "Circuitos de Controle"
	quest.171F80AB064BEF9F.quest_desc: ["Cobre + zinco fazem latão, o coração do Create."]
	quest.171F80AB064BEF9F.title: "Zinco"
	quest.172C5D9B334EC305.quest_desc: ["Melhore a mochila na bancada com ferro, ouro, diamante e netherite. Nada do que está dentro se perde."]
	quest.172C5D9B334EC305.title: "Mochilas Maiores"
	quest.172FC8830AA5934A.quest_desc: ["Equipamento com espaços de módulos. Abra (agache + clique) e coloque módulos: escudo, velocidade, dano, voo."]
	quest.172FC8830AA5934A.title: "Equipamento Wyvern"
	quest.178C819CF2C51AFA.quest_desc: ["Tudo que entra é apagado. Ótima no fim de uma linha de produção."]
	quest.178C819CF2C51AFA.title: "Lixeira"
	quest.1798208D9C6ECF9D.quest_desc: [
		"O Ad Astra leva você ao espaço: a Lua, Marte, Vênus, Mercúrio e o planeta congelado Glacio."
		""
		"Tudo começa pelo Compressor, que transforma lingotes em placas."
	]
	quest.1798208D9C6ECF9D.quest_subtitle: "Ad Astra"
	quest.1798208D9C6ECF9D.title: "Rumo às Estrelas"
	quest.179B15C41FC05B0B.quest_desc: ["Pesquise e instale aumentos em você: mais vida, velocidade, voo e mais."]
	quest.179B15C41FC05B0B.title: "Aumentos"
	quest.17BA697BF194E216.quest_desc: ["Ferro comprimido na Pressure Chamber (ou explodido com TNT no começo). A base do mod."]
	quest.17BA697BF194E216.title: "Ferro Comprimido"
	quest.17C3EF9264DB33D8.quest_desc: ["Queima combustível para energia."]
	quest.17C3EF9264DB33D8.title: "Gerador"
	quest.17EBAA1B51D33D60.quest_desc: ["Forte o bastante para chegar a Marte."]
	quest.17EBAA1B51D33D60.title: "Foguete Nível 2"
	quest.17F5C06957D04B81.quest_desc: ["Faz aço. As máquinas do MI ficam melhores com aço."]
	quest.17F5C06957D04B81.title: "Alto-Forno a Vapor"
	quest.17FDADFF14051C49.quest_desc: ["Desmonta ferramentas de volta em peças."]
	quest.17FDADFF14051C49.title: "Salvager"
	quest.1845F5F95E9415AF.quest_desc: ["Os funis colocam e tiram itens de máquinas e baús. Os dutos derrubam itens para baixo."]
	quest.1845F5F95E9415AF.title: "Funis e Dutos"
	quest.186FBC04CBBE50F0.quest_desc: ["O MI começa com vapor. O Forge Hammer transforma minérios em pós e lingotes em placas."]
	quest.186FBC04CBBE50F0.title: "Forge Hammer"
	quest.187A9DC82B0163EC.quest_desc: ["Para morar em outro planeta: o Oxygen Distributor enche uma sala fechada de ar, o Gravity Normalizer corrige a gravidade e os Solar Panels dão energia."]
	quest.187A9DC82B0163EC.title: "Base Espacial"
	quest.1897BEB996D951F4.quest_desc: ["O Silent Gems adiciona gemas de muitas cores, usadas no Silent Gear e como decoração."]
	quest.1897BEB996D951F4.title: "Silent Gems"
	quest.18E86E0E4C54E3D1.quest_desc: ["As Waystones ficam nas vilas. Clique para registrar e depois teleporte entre elas com uma Warp Stone."]
	quest.18E86E0E4C54E3D1.title: "Waystones"
	quest.191A44BFAF231CD3.quest_desc: ["Carregue pela culatra: primeiro as cargas de pólvora, depois o projétil. Atire com redstone."]
	quest.191A44BFAF231CD3.title: "Carregando"
	quest.197CBAE501E89228.quest_desc: ["As Relíquias sobem de nível conforme você usa. Cada nível deixa as habilidades mais fortes."]
	quest.197CBAE501E89228.title: "Relíquias"
	quest.19968F7D2B9773E4.quest_desc: ["Reage um item, um fluido e um gás. Faz substrato, eteno, plástico HDPE e, mais tarde, as Balas Radioativas."]
	quest.19968F7D2B9773E4.title: "Pressurized Reaction Chamber"
	quest.19B0F95F524B3FEA.quest_desc: ["Estende uma parede ou chão de blocos com um clique, usando os blocos do inventário."]
	quest.19B0F95F524B3FEA.title: "Bastão de Construção"
	quest.19B8C7C90FC0F1FA.quest_desc: ["Coloque um modo (cubo, esfera, domo) no meio e Scale Modules em volta para criar um campo de força daquele formato."]
	quest.19B8C7C90FC0F1FA.title: "Projetor"
	quest.1A0AE279F723599A.quest_desc: ["As Ender Cells e os Gates compartilham energia num canal pelo mundo."]
	quest.1A0AE279F723599A.title: "Rede Ender"
	quest.1A2ACF5B89989666.quest_desc: ["O segundo nível de circuito. Cada nível libera máquinas melhores."]
	quest.1A2ACF5B89989666.title: "Circuito Eletrônico"
	quest.1A525214C614364B.quest_desc: ["Um revólver personalizável, feito na Engineer's Workbench."]
	quest.1A525214C614364B.title: "Revólver"
	quest.1A839C9D75223C9D.quest_desc: ["Funciona como a Bússola do Explorador, mas encontra biomas."]
	quest.1A839C9D75223C9D.title: "Bússola da Natureza"
	quest.1AAD4C85A62866E8.quest_desc: ["Faça uma picareta de madeira, minere pedra e passe para uma picareta de pedra."]
	quest.1AAD4C85A62866E8.title: "Idade da Pedra"
	quest.1ABE77E1EC7CCD4A.quest_desc: ["Uma caixa oca de Reactor Casing com um controlador, barras de combustível dentro e um Power Tap. O tamanho é você quem escolhe: reatores maiores são mais eficientes."]
	quest.1ABE77E1EC7CCD4A.title: "Reator"
	quest.1ACDF21370FE8285.quest_desc: ["Com oxigênio, a Purification Chamber transforma 1 minério em 3 clumps."]
	quest.1ACDF21370FE8285.title: "Minério x3"
	quest.1AE14A52887D0987.quest_desc: ["Gira os favos em cera, mel e o recurso do favo. A Powered Centrifuge é mais rápida."]
	quest.1AE14A52887D0987.title: "Centrífuga"
	quest.1AEBCA4BBE7A0F45.quest_desc: ["O reator nuclear do MI. Ele faz plutônio e Tritium, necessários para a Munição Universal e o The Absolute."]
	quest.1AEBCA4BBE7A0F45.title: "Reator Nuclear"
	quest.1B03221F24D913C6.quest_desc: ["Mais glifos por feitiço e mais mana."]
	quest.1B03221F24D913C6.title: "Livro de Aprendiz"
	quest.1B0954A9A4FA42CD.quest_desc: ["Block Breaker, Block Placer e Clicker: blocos pequenos que fazem uma tarefa, com filtros e controle por redstone."]
	quest.1B0954A9A4FA42CD.title: "Máquinas Simples"
	quest.1B336C9360ABF5CF.quest_desc: ["Coloque um cristal no Empowerer e os itens certos em 4 Display Stands em volta."]
	quest.1B336C9360ABF5CF.title: "Cristais Potencializados"
	quest.1B626AA8DB940792.quest_desc: ["Feito com Dragon Heart ou na Fusion Crafting. Necessário para os equipamentos dracônicos."]
	quest.1B626AA8DB940792.title: "Dracônio Desperto"
	quest.1B75C839A8FB5AEC.quest_desc: ["Um material de ritual da forja para os níveis mais altos."]
	quest.1B75C839A8FB5AEC.title: "Matéria Escura"
	quest.1BC9E8C9D907D2B8.quest_desc: ["Uma estrutura oca de Induction Casing com células e providers dentro. Guarda uma quantidade enorme de energia."]
	quest.1BC9E8C9D907D2B8.title: "Induction Matrix"
	quest.1BD9A063A44F1726.quest_desc: ["Mate mobs com a Soulium Dagger e um Soul Jar vazio no inventário. As sementes de mobs (zumbi, blaze, esqueleto wither) precisam de almas."]
	quest.1BD9A063A44F1726.title: "Almas"
	quest.1C18C27400E18199.quest_desc: ["Lançam um feitiço a partir de um bloco com redstone. Automatize fazendas, quebra e colocação com magia."]
	quest.1C18C27400E18199.title: "Torres de Feitiço"
	quest.1C322A49693F06F5.quest_desc: ["Shock machuca quem encosta no campo, Camouflage disfarça, Fusion junta campos."]
	quest.1C322A49693F06F5.title: "Módulos"
	quest.1C78265376523E66.quest_desc: ["A espada do Ignis. Segure o botão direito para chamar um pilar de fogo."]
	quest.1C78265376523E66.title: "The Incinerator"
	quest.1C8D7BD9C9B89C78.quest_desc: ["O Mekanism gira em torno do ósmio. Minere e derreta."]
	quest.1C8D7BD9C9B89C78.title: "Ósmio"
	quest.1CB766C921F25BCC.quest_desc: ["Aprenda um feitiço usando o pergaminho dele. Existem pergaminhos de olhos, barreiras, projeção, deslocamento e mais."]
	quest.1CB766C921F25BCC.title: "Pergaminhos de Feitiço"
	quest.1CC6E8013527FBFB.quest_desc: ["Derreta carvão em grafite, usado nas barras de combustível e nos cascos."]
	quest.1CC6E8013527FBFB.title: "Grafite"
	quest.1CE31E0EB9CF8E5E.quest_desc: ["Reprocesse o resíduo do reator (Cyanite) em Blutonium, um combustível melhor."]
	quest.1CE31E0EB9CF8E5E.title: "Blutonium"
	quest.1CF02D0C694D53C9.quest_desc: ["As molduras Simple, Advanced e Supreme são feitas na Dissolution Chamber com Pink Slime e Ether Gas."]
	quest.1CF02D0C694D53C9.title: "Molduras Melhores"
	quest.1D385329A87A27E0.quest_desc: ["O Awakening Altar com 4 Essence Vessels (essências de ar, terra, água e fogo) faz o Awakened Supremium."]
	quest.1D385329A87A27E0.title: "Despertar"
	quest.1D5A172C69AFA9AF.quest_desc: ["Coloque encostado nas gavetas: tudo que entra no controlador vai para a gaveta certa."]
	quest.1D5A172C69AFA9AF.title: "Controlador de Gavetas"
	quest.1D6B0830E6035EFB.quest_desc: ["Molduras de todo formato (rampas, escadas, painéis) que pegam a textura do bloco com que você clicar."]
	quest.1D6B0830E6035EFB.title: "Framed Blocks"
	quest.1D80002253C7728A.quest_desc: ["Farmer para plantações, Canning Machine para encher itens com fluidos e Brewery para poções."]
	quest.1D80002253C7728A.title: "Máquinas do EI"
	quest.1DA0A6DCB2221898.quest_desc: ["Ache as Catacumbas do Undergarden e derrote o Forgotten Guardian para conseguir o Forgotten Metal."]
	quest.1DA0A6DCB2221898.title: "Forgotten Guardian"
	quest.1DBDE7F28E6220D6.quest_desc: ["Durma em qualquer lugar sem mudar o seu ponto de renascimento."]
	quest.1DBDE7F28E6220D6.title: "Saco de Dormir"
	quest.1DD37AB815E21D38.quest_desc: ["Um escudo que absorve quase todo dano, além de módulos de voo e mais."]
	quest.1DD37AB815E21D38.title: "Armadura Dracônica"
	quest.1DDA8CC6A8537E36.quest_desc: ["Segure o botão direito sobre as plantações para crescerem mais rápido."]
	quest.1DDA8CC6A8537E36.title: "Regador"
	quest.1E0CCC1B12E3E583.quest_desc: [
		"Munição Universal irradiada na Pressurized Reaction Chamber do Mekanism, com Água Pesada e Polônio."
		""
		"Ela deixa Lixo Nuclear Gasto para trás. Tenha onde guardar."
	]
	quest.1E0CCC1B12E3E583.title: "Bala Radioativa"
	quest.1E5334D183C76C5A.quest_desc: ["Vive no Pântano de Fogo. Acerte as cabeças quando estão de boca aberta; matar uma cabeça faz nascer duas, então continue batendo até o corpo morrer."]
	quest.1E5334D183C76C5A.title: "A Hidra"
	quest.1E65D0D27186F6C2.quest_desc: ["Conserta os itens dentro usando sangue."]
	quest.1E65D0D27186F6C2.title: "Blood Chest"
	quest.1E86F2D0D4D7970D.quest_desc: ["Mantém um estoque de itens disponível para as máquinas e aceita tudo o que entra."]
	quest.1E86F2D0D4D7970D.title: "ME Interface"
	quest.1E88E432C0601BA2.quest_desc: ["Uma plataforma levantada por pressão de ar."]
	quest.1E88E432C0601BA2.title: "Elevador"
	quest.1EC18D43765AA9E7.quest_desc: ["CBC Advanced Technologies: lançadores de foguetes, autocanhões pesados e mais projéteis."]
	quest.1EC18D43765AA9E7.title: "Lançadores de Foguetes"
	quest.1EE2A9E45EB8E01C.quest_desc: ["Esteiras rápidas com melhorias para inserir, extrair e separar."]
	quest.1EE2A9E45EB8E01C.title: "Esteiras"
	quest.1EE7531E13909628.quest_desc: ["O armazenamento digital do Mekanism: QIO Drives num Drive Array, acessados pelo Dashboard na mesma frequência."]
	quest.1EE7531E13909628.title: "QIO"
	quest.1EFE01EFB8ABEDA4.quest_desc: ["Árvores mágicas de quatro cores espalhadas pelo mundo. A madeira delas faz a maioria dos blocos do Ars."]
	quest.1EFE01EFB8ABEDA4.title: "Archwood"
	quest.1F150497B86D5686.quest_desc: ["Uma caixa de Reactor Walls com barras, ventilações e refletores dentro. O arranjo decide a potência."]
	quest.1F150497B86D5686.title: "Reator do Oritech"
	quest.1F256F23F468F2B3.quest_desc: ["Controlador + ME Drive com células de armazenamento + Terminal: todos os itens numa tela com busca. Ligue com cabos ME."]
	quest.1F256F23F468F2B3.title: "Rede ME"
	quest.1F664EA1F6E51A31.quest_desc: ["Tábuas mergulhadas em creosoto. Usadas em postes, moinhos e muitas máquinas."]
	quest.1F664EA1F6E51A31.title: "Madeira Tratada"
	quest.1F81C36BBB0EBBEF.quest_desc: ["Guarde o Source do Ars Nouveau na rede ME."]
	quest.1F81C36BBB0EBBEF.title: "Ars Énergistique"
	quest.1F958A9DEDF90B1A.quest_desc: ["Transforma sementes sobrando de volta em essência."]
	quest.1F958A9DEDF90B1A.title: "Seed Reprocessor"
	quest.1FB9A9CB953A595B.quest_desc: ["Algumas abelhas são feitas clicando numa abelha com um item. É assim que nasce a Abelha Absoluta."]
	quest.1FB9A9CB953A595B.title: "Conversão"
	quest.202D0CD17A09147E.quest_desc: ["Capture um mob com a Mob Imprisonment Tool e o Duplicator cria cópias usando Essence."]
	quest.202D0CD17A09147E.title: "Duplicador de Mobs"
	quest.2046CB4E5F506EAF.quest_desc: ["Agache + clique num lado da máquina para mudar o que entra ou sai. Também faz os canos puxarem ou empurrarem."]
	quest.2046CB4E5F506EAF.title: "Configurator"
	quest.20A6D650303DE59B.quest_desc: ["Create Diesel Generators: motores que queimam combustível para dar rotação. Diesel e gasolina vêm do petróleo."]
	quest.20A6D650303DE59B.title: "Motor a Diesel"
	quest.20B5EAAA47F09DCF.quest_desc: ["Os drones levam itens entre baús marcados com Logistics Frames."]
	quest.20B5EAAA47F09DCF.title: "Drones de Logística"
	quest.20CE31DE33AFD289.quest_desc: ["Passe o swab num mob, faça Chicken Feed com ele, e o ovo que a galinha bota vai no Entity Spawner."]
