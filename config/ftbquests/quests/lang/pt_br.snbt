	quest.7453E8E1B4EFFB32.quest_desc: ["Espoletas de impacto, de tempo e de proximidade decidem quando o projétil explode."]
	quest.7453E8E1B4EFFB32.title: "Espoletas"
	quest.7462B28D1B493173.quest_desc: ["Fica na estrutura Soul Black Smith no Nether."]
	quest.7462B28D1B493173.title: "Netherite Monstrosity"
	quest.74FC265D5523B66B.quest_desc: ["Transforma a rotação de uma Roda d'Água ou Moinho de Vento em energia."]
	quest.74FC265D5523B66B.title: "Dínamo Cinético"
	quest.751B91E45E123AE7.quest_desc: ["Lápis-lazúli ou ametista na Imbuement Chamber. O material base do mod."]
	quest.751B91E45E123AE7.title: "Source Gems"
	quest.7549A2B35AD6826D.quest_desc: ["Tanques de Fluido com Blaze Burners embaixo viram uma caldeira. Coloque um Motor a Vapor do lado para muita rotação."]
	quest.7549A2B35AD6826D.title: "Motor a Vapor"
	quest.75662A02272F8FDF.quest_desc: ["Um rifle eletromagnético que atravessa fileiras de mobs."]
	quest.75662A02272F8FDF.title: "Gauss Rifle"
	quest.75CF6503339669A0.quest_desc: ["Mói minérios em minérios triturados, que dão lingotes extras quando lavados e derretidos."]
	quest.75CF6503339669A0.title: "Moinho"
	quest.7636D9124C9A0F4D.quest_desc: ["O Atomic Disassembler é toda ferramenta numa só. O Jetpack voa com hidrogênio. Os Free Runners tiram o dano de queda."]
	quest.7636D9124C9A0F4D.title: "Ferramentas"
	quest.763D4DD5B05F090E.quest_desc: ["Peças maiores e melhores do AE2: Extended Pattern Providers, Assembler Matrix e mais."]
	quest.763D4DD5B05F090E.title: "ExtendedAE"
	quest.76643AC98EBD9F91.quest_desc: ["Guarda ar para respirar embaixo d'água e alimenta ferramentas do Create como o Extendo Grip."]
	quest.76643AC98EBD9F91.title: "Tanque de Ar"
	quest.768B8992B2F01DB8.quest_desc: ["As armas de energia usam plasma. O Plasma Core é usado na Munição Universal."]
	quest.768B8992B2F01DB8.title: "Plasma"
	quest.76B652D1CB1DA906.quest_desc: ["Dois anéis de 8 Quantum Rings em volta de um Quantum Link, cada um com uma das singularidades do par: uma rede em dois lugares."]
	quest.76B652D1CB1DA906.title: "Ponte Quântica"
	quest.76BDEBC82AD50219.quest_desc: ["Braços robóticos que cortam e furam peças, como os PCBs avançados."]
	quest.76BDEBC82AD50219.title: "Linha de Montagem"
	quest.76CB6D27221095BB.quest_desc: ["Uma estrutura que captura raios para uma descarga enorme de energia."]
	quest.76CB6D27221095BB.title: "Para-Raios"
	quest.770627E8836189DB.quest_desc: ["Os monstros derrubam equipamentos com afixos (atributos bônus) e gemas. Coloque as gemas nos encaixes do equipamento na Mesa de Ferraria."]
